<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_workorder_pause_reason_wizard" model="ir.ui.view">
        <field name="name">workorder.pause.reason.wizard.form</field>
        <field name="model">workorder.pause.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Pause Reason">
                <group>
                    <field name="service_id" invisible="1"/>
                    <field name="pause_reason_id" widget="radio"/>
                    <field name="pause_reason_note"
                           placeholder="Optional details (required when reason needs a note)..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Pause" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
