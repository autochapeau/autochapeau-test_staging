<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="pause_reason_waiting_parts" model="workorder.pause.reason">
        <field name="name">Waiting for parts</field>
        <field name="sequence">10</field>
    </record>
    <record id="pause_reason_waiting_customer" model="workorder.pause.reason">
        <field name="name">Waiting for customer</field>
        <field name="sequence">20</field>
    </record>
    <record id="pause_reason_staff_break" model="workorder.pause.reason">
        <field name="name">Staff break</field>
        <field name="sequence">30</field>
    </record>
    <record id="pause_reason_equipment_issue" model="workorder.pause.reason">
        <field name="name">Equipment / tool issue</field>
        <field name="sequence">40</field>
    </record>
    <record id="pause_reason_quality_issue" model="workorder.pause.reason">
        <field name="name">Quality / rework</field>
        <field name="sequence">50</field>
    </record>
    <record id="pause_reason_other" model="workorder.pause.reason">
        <field name="name">Other</field>
        <field name="sequence">90</field>
        <field name="requires_note" eval="True"/>
    </record>
    <record id="pause_reason_finished" model="workorder.pause.reason">
        <field name="name">Finished</field>
        <field name="sequence">100</field>
        <field name="is_finish" eval="True"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
