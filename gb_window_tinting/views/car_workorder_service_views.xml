<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="car_workorderservice_view_form_window_tinting" model="ir.ui.view">
        <field name="name">car.workorder.service.form.window.tinting</field>
        <field name="model">car.workorder.service</field>
        <field name="inherit_id" ref="work_orders.car_workorderservice_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="is_window_tinting" invisible="1"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <separator string="Window Tinting Details"
                           invisible="not is_window_tinting"/>
                <field name="tint_details_summary"
                       readonly="1"
                       invisible="not is_window_tinting"/>
                <field name="tint_detail_ids"
                       readonly="1"
                       nolabel="1"
                       invisible="not is_window_tinting">
                    <tree create="0" delete="0" edit="0">
                        <field name="glass_type_id"/>
                        <field name="tint_percentage_id"/>
                        <field name="note"/>
                    </tree>
                </field>
            </xpath>
        </field>
    </record>

</odoo>
