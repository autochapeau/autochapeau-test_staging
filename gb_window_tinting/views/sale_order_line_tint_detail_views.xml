<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_line_tint_details_form" model="ir.ui.view">
        <field name="name">sale.order.line.tint.details.form</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <form string="Tint Details">
                <sheet>
                    <group>
                        <field name="order_id" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="product_uom_qty" readonly="1"/>
                        <field name="price_unit" readonly="1"/>
                    </group>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_generate_tint_details"
                                type="object"
                                string="Generate Glass Types"
                                class="oe_stat_button"
                                icon="fa-magic"/>
                    </div>

                    <group string="Glass Tint Details">
                        <field name="tint_detail_ids"
                               context="{'default_sale_order_line_id': active_id}">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="available_glass_type_ids"
                                       column_invisible="1"/>
                                <field name="available_tint_percentage_ids"
                                       column_invisible="1"/>
                                <field name="glass_type_id"
                                       domain="[('id', 'in', available_glass_type_ids)]"
                                       options="{'no_create': True, 'no_open': True}"/>
                                <field name="tint_percentage_id"
                                       domain="[('id', 'in', available_tint_percentage_ids)]"
                                       options="{'no_create': True, 'no_open': True}"/>
                                <field name="note" optional="show"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button string="Save" special="save" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
