<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_qa_fault" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.qa.fault</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='default_accounts']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">QA Fault Accounting</span>
                        <div class="text-muted">
                            Accounts used when posting technician / company cost split from QA faults.
                        </div>
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="qa_fault_journal_id" class="col-lg-5 o_light_label"/>
                                <field name="qa_fault_journal_id"/>
                            </div>
                            <div class="row mt8">
                                <label for="qa_fault_technician_account_id" class="col-lg-5 o_light_label"/>
                                <field name="qa_fault_technician_account_id"/>
                            </div>
                            <div class="row mt8">
                                <label for="qa_fault_company_account_id" class="col-lg-5 o_light_label"/>
                                <field name="qa_fault_company_account_id"/>
                            </div>
                            <div class="row mt8">
                                <label for="qa_fault_offset_account_id" class="col-lg-5 o_light_label"/>
                                <field name="qa_fault_offset_account_id"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
