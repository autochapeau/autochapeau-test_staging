<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <template id="report_journal_entry_document">
  <t t-call="account_move_print.external_layout_autochapeau">
   <t t-set="o" t-value="o.with_context(lang=lang or user.lang)"/>
   <t t-set="lines" t-value="o.line_ids.filtered('account_id')"/>
   <t t-set="foreign" t-value="any(l.currency_id and l.currency_id != o.company_currency_id for l in lines)"/>
   <t t-set="total_debit" t-value="sum(lines.mapped('debit'))"/>
   <t t-set="total_credit" t-value="sum(lines.mapped('credit'))"/>
   <div class="page ac-journal">
    <style>
     .ac-journal { font-size:12px; color:#29252d; }
     .ac-journal .ac-title { padding:14px 16px; background:#f5f1ed; color:#4c153e; border-left:4px solid #b79a73; margin-bottom:18px; }
     .ac-journal .ac-title table { width:100%; background:transparent; color:inherit; border:none; }
     .ac-journal .ac-title tr { border:0 !important; }
     .ac-journal .ac-title td { border:none; padding:0; vertical-align:middle; background:#f5f1ed !important; color:#4c153e !important; }
     .ac-journal .ac-title td * { color:#4c153e !important; }
     .ac-journal h2 { font-size:24px; color:#4c153e; margin:5px 0 0; letter-spacing:.4px; }
     .ac-journal .ac-kicker { font-size:10px; color:#9b7b53 !important; letter-spacing:1.5px; }
     .ac-journal .ac-meta { width:100%; background:#faf8f5; margin-bottom:18px; border-collapse:collapse; }
     .ac-journal .ac-meta td { width:50%; padding:10px 14px 4px; vertical-align:top; border:1px solid #e7e1da; background:#faf8f5 !important; }
     .ac-journal small { color:#807680; font-size:10px; }
     .ac-journal .ac-meta p { margin:2px 0 9px; font-size:12px; }
     .ac-journal .ac-lines { width:100%; border-collapse:collapse; font-size:12px; table-layout:fixed; }
     .ac-journal .ac-lines thead th { background:#4c153e !important; color:#fff !important; padding:10px 7px; border:0; font-size:10px; line-height:1.5; }
     .ac-journal .ac-lines thead th * { color:#fff !important; }
     .ac-journal .ac-lines td { padding:11px 7px; vertical-align:top; border-bottom:1px solid #e7e1da; word-wrap:break-word; font-size:11px; line-height:1.5; }
     .ac-journal .ac-lines tbody tr:nth-child(even) { background:#faf8f5; }
     .ac-journal .ac-lines tfoot td { background:#4c153e !important; color:#fff !important; font-size:12px; font-weight:bold; border-top:2px solid #b79a73; }
     .ac-journal .num { text-align:right; white-space:nowrap; }
     .ac-journal .ac-signatures { width:100%; margin-top:32px; page-break-inside:avoid; border-collapse:separate; border-spacing:10px 0; }
     .ac-journal .ac-signatures td { width:33.33%; padding:12px 10px; border:1px solid #e7e1da; border-top:2px solid #b79a73; vertical-align:top; background:#faf8f5 !important; height:70px; }
     .ac-journal thead { display:table-header-group; }
     .ac-journal tfoot { display:table-row-group; }
     .ac-journal tr { page-break-inside:avoid; }
    </style>
    <div class="ac-title"><table><tr><td style="width:65%">
     <div class="ac-kicker">JOURNAL ENTRY / قيد محاسبي</div>
     <h2 t-field="o.name"/>
    </td><td style="text-align:right;width:35%">
     <strong t-if="o.state == 'posted'">POSTED / مرحّل</strong>
     <strong t-elif="o.state == 'draft'">DRAFT / مسودة</strong>
     <strong t-else="">CANCELLED / ملغى</strong>
     <div t-field="o.company_currency_id.name"/>
    </td></tr></table></div>
    <table class="ac-meta"><tr><td>
     <small>Accounting Date / التاريخ المحاسبي</small><p><strong t-field="o.date"/></p>
     <small>Journal / اليومية</small><p t-field="o.journal_id.name"/>
    </td><td>
     <small>Reference / المرجع</small><p t-out="o.ref or '—'"/>
     <small>Partner / الطرف</small><p t-out="o.partner_id.name or '—'"/>
    </td></tr></table>
    <table class="ac-lines" name="lines_content"><thead><tr>
     <th style="width:23%">Account<br/>الحساب</th>
     <th t-att-style="'width:21%' if foreign else 'width:34%'">Description<br/>البيان</th>
     <th t-att-style="'width:15%' if foreign else 'width:17%'">Partner<br/>الطرف</th>
     <th t-if="foreign" style="width:15%" class="num">Foreign Amount<br/>المبلغ بالعملة</th>
     <th style="width:13%" class="num">Debit<br/>مدين</th>
     <th style="width:13%" class="num">Credit<br/>دائن</th>
    </tr></thead><tbody>
     <tr t-foreach="lines" t-as="line">
      <td><strong t-field="line.account_id.code"/><br/><span t-field="line.account_id.name"/></td>
      <td><span t-field="line.name"/>
       <div t-if="line.tax_ids or line.tax_line_id"><small t-out="', '.join((line.tax_ids | line.tax_line_id).mapped('name'))"/></div>
      </td>
      <td><span t-field="line.partner_id.name"/></td>
      <td t-if="foreign" class="num"><span t-if="line.currency_id != o.company_currency_id" t-field="line.amount_currency" t-options="{'widget':'monetary','display_currency':line.currency_id}"/></td>
      <td class="num"><span t-field="line.debit" t-options="{'widget':'monetary','display_currency':o.company_currency_id}"/></td>
      <td class="num"><span t-field="line.credit" t-options="{'widget':'monetary','display_currency':o.company_currency_id}"/></td>
     </tr>
    </tbody><tfoot><tr>
     <td t-att-colspan="4 if foreign else 3">TOTAL / الإجمالي</td>
     <td class="num"><span t-out="total_debit" t-options="{'widget':'monetary','display_currency':o.company_currency_id}"/></td>
     <td class="num"><span t-out="total_credit" t-options="{'widget':'monetary','display_currency':o.company_currency_id}"/></td>
    </tr></tfoot></table>
    <div style="text-align:right;margin-top:9px"><small>Difference / الفرق: </small><span t-out="total_debit-total_credit" t-options="{'widget':'monetary','display_currency':o.company_currency_id}"/></div>
    <table class="ac-signatures"><tr>
     <td><small>Prepared by / أعدّه</small><p t-field="o.create_uid.name"/></td>
     <td><small>Reviewed by / المراجع</small><p style="height:20px"/></td>
     <td><small>Approved by / المعتمد</small><p style="height:20px"/></td>
    </tr></table>
   </div>
  </t>
 </template>
 <template id="report_journal_entries">
  <t t-call="web.html_container"><t t-foreach="docs" t-as="o">
   <t t-set="lang" t-value="user.lang or 'en_US'"/>
   <t t-call="account_move_print.report_journal_entry_document" t-lang="lang"/>
  </t></t>
 </template>
 <record id="action_report_journal_entries" model="ir.actions.report">
  <field name="name">Journal Entries</field><field name="model">account.move</field>
  <field name="report_type">qweb-pdf</field><field name="report_name">account_move_print.report_journal_entries</field>
  <field name="report_file">account_move_print.report_journal_entries</field>
  <field name="binding_model_id" ref="account.model_account_move"/><field name="binding_view_types">list,form</field>
  <field name="paperformat_id" ref="account_move_print.paperformat_autochapeau"/>
  <field name="print_report_name">'Journal - %s' % (object.name or 'Draft').replace('/', '-')</field>
 </record>
</odoo>
