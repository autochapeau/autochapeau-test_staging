<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_quality_read_maintenance" model="ir.rule">
        <field name="name">Quality read maintenance sale orders</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="groups" eval="[(4, ref('work_orders.group_quality_officer'))]"/>
        <field name="domain_force">['|', ('maintenance_claim_id', '!=', False), ('maintenance_claim_ids', '!=', False)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="sale_order_quality_write_maintenance" model="ir.rule">
        <field name="name">Quality write maintenance sale orders</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="groups" eval="[(4, ref('work_orders.group_quality_officer'))]"/>
        <field name="domain_force">[('maintenance_claim_id', '!=', False)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="sale_order_line_quality_read_maintenance" model="ir.rule">
        <field name="name">Quality read maintenance sale order lines</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="groups" eval="[(4, ref('work_orders.group_quality_officer'))]"/>
        <field name="domain_force">['|', ('order_id.maintenance_claim_id', '!=', False), ('order_id.maintenance_claim_ids', '!=', False)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="maintenance_claim_company_rule" model="ir.rule">
        <field name="name">Maintenance claim multi-company</field>
        <field name="model_id" ref="model_maintenance_claim"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
