<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="maintenance_claim_wizard_view_form" model="ir.ui.view">
        <field name="name">maintenance.claim.wizard.form</field>
        <field name="model">maintenance.claim.wizard</field>
        <field name="arch" type="xml">
            <form string="Maintenance Request">
                <group>
                    <field name="sale_order_id"/>
                    <field name="available_line_ids" invisible="1"/>
                    <field name="service_line_id" options="{'no_create': True}"/>
                    <field name="problem_location"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Send to Quality" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
