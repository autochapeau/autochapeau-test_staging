<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="car_work_order_form_extern_upsell" model="ir.ui.view">
        <field name="name">car.work.order.form.extern.upsell</field>
        <field name="model">car.work.order</field>
        <field name="inherit_id" ref="work_orders.car_work_order_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_extern_upsell_sale_order"
                        string="Add Upsell Order"
                        type="object"
                        class="btn-secondary"
                        invisible="not is_extern_work_order or parent_id or state in ('done', 'cancelled') or extern_extra_sale_order_count &gt; 0"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="is_extern_work_order" invisible="1"/>
                <field name="extern_extra_sale_order_count" invisible="1"/>
                <button name="action_view_extern_extra_sale_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        invisible="not is_extern_work_order or extern_extra_sale_order_count == 0">
                    <field name="extern_extra_sale_order_count"
                           widget="statinfo"
                           string="Upsells"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
