<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form_extern_upsell" model="ir.ui.view">
        <field name="name">sale.order.form.extern.upsell</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="partner_management.view_order_form_inherit_subordinate"/>
        <field name="arch" type="xml">
            <!-- Dedicated Extern button (Contract keeps its own visibility) -->
            <xpath expr="//button[@name='action_create_extra_sale_order']" position="after">
                <button name="action_create_extra_sale_order"
                        string="Create Extra Order"
                        type="object"
                        class="btn-secondary"
                        invisible="order_type != 'extern' or state not in ('sale', 'done') or not id or child_sale_count &gt; 0"/>
            </xpath>
            <!-- Extras share the parent appointment -->
            <xpath expr="//button[@name='action_create_appointment']" position="attributes">
                <attribute name="invisible">state not in ('sale', 'done') or not id or not vehicle_id or appointment_count &gt; 0 or related_sale_id or not has_service_product_lines</attribute>
            </xpath>
            <xpath expr="//field[@name='related_sale_id']" position="before">
                <field name="is_extern_visit_order" invisible="1"/>
                <field name="extern_appointment_id"
                       readonly="1"
                       invisible="not is_extern_visit_order"/>
            </xpath>
            <xpath expr="//field[@name='related_sale_id']" position="after">
                <field name="extern_work_order_id"
                         readonly="1"
                         invisible="not is_extern_visit_order"/>
            </xpath>
        </field>
    </record>
</odoo>
