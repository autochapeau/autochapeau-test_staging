<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_form_fix_amount_discounts" model="ir.ui.view">
        <field name="name">account.move.form.fix.amount.discounts</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_fix_amount_discounts_from_sale"
                    type="object"
                    string="Rebuild Lines from SO"
                    class="btn-secondary"
                    groups="account.group_account_invoice,sales_team.group_sale_manager"
                    invisible="state != 'draft' or move_type not in ('out_invoice', 'out_refund')"
                    confirm="Delete current product lines on this draft invoice and rebuild them from the related sale order (exact discounts)?"
                />
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='discount']" position="before">
                <field
                    name="discount_type"
                    string="Disc. Type"
                    optional="show"
                    groups="product.group_discount_per_so_line"
                />
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='discount']" position="after">
                <field
                    name="discount_amount"
                    string="Disc. Amount"
                    optional="show"
                    groups="product.group_discount_per_so_line"
                    column_invisible="parent.move_type not in ('out_invoice', 'out_refund', 'out_receipt')"
                    invisible="discount_type != 'amount'"
                />
            </xpath>
        </field>
    </record>
</odoo>
