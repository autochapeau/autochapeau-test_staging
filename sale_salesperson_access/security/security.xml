<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_edit_salesperson" model="res.groups">
        <field name="name">Edit Salesperson on Sales Order</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">بتسمح للمستخدم يغيّر مندوب البيع على عروض الأسعار وأوامر البيع اللي عنده حق يعدّلها.</field>
    </record>

    <data noupdate="1">
        <function model="res.groups" name="write"
                  eval="[[ref('group_edit_salesperson')], {'users': [(4, ref('base.user_admin')), (4, ref('base.user_root'))]}]"/>
    </data>

</odoo>
