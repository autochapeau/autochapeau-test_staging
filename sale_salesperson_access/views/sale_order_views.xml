<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_order_form_salesperson_access" model="ir.ui.view">
        <field name="name">sale.order.form.salesperson.access</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']//field[@name='user_id']" position="replace">
                <field name="user_id"
                       widget="many2one_avatar_user"
                       groups="sale_salesperson_access.group_edit_salesperson"/>
                <field name="user_id"
                       widget="many2one_avatar_user"
                       readonly="1"
                       groups="!sale_salesperson_access.group_edit_salesperson"/>
            </xpath>
        </field>
    </record>

</odoo>
