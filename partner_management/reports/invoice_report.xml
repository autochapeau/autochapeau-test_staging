<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <template id="report_invoice_vehicle_custom" inherit_id="l10n_gcc_invoice.arabic_english_invoice" priority="70">
  <xpath expr="//t[@t-call='web.external_layout']" position="attributes"><attribute name="t-call">account_move_print.external_layout_autochapeau</attribute></xpath>
  <xpath expr="//div[hasclass('page')]" position="attributes"><attribute name="class" add="ac-invoice" separator=" "/></xpath>
  <xpath expr="//div[hasclass('page')]/h3/div/div[1]" position="attributes"><attribute name="t-translation">off</attribute></xpath>
  <xpath expr="//div[hasclass('page')]/h3" position="before">
   <style>
    .ac-invoice { font-size:12px; color:#29252d; }
    .ac-invoice h3 { background:#f5f1ed; color:#4c153e; padding:14px 12px; border-left:4px solid #b79a73; font-size:17px; margin:0 0 14px; }
    .ac-invoice h3 .col-4:nth-child(2) { font-size:19px; font-weight:bold; letter-spacing:.4px; }
    .ac-invoice .ac-customer { width:100%; border:0 !important; border-collapse:collapse; margin:0 0 14px; }
    .ac-invoice .ac-customer td { border:0; vertical-align:top; padding:0; }
    .ac-invoice .ac-customer tr { border:0 !important; }
    .ac-invoice .ac-customer address { margin-bottom:3px; text-align:left !important; font-size:12px; line-height:1.5; }
    .ac-invoice .ac-customer .mt16 { margin-top:4px !important; text-align:left !important; font-size:10px; }
    .ac-invoice .ac-customer img[src*='/report/barcode/'] { width:90px !important; height:90px !important; margin-left:auto; }
    .ac-invoice .ac-customer .row { margin:0; display:block; }
    .ac-invoice .ac-customer .row p { margin:0; float:right; width:auto; padding:0; }
    .ac-invoice .ac-customer .row [name='shipping_address_block'] { font-size:10px; width:100%; padding:5px 0 0; }
    .ac-invoice .ac-overline { font-size:9px; color:#9b7b53; font-weight:bold; letter-spacing:1.4px; margin-bottom:5px; }
    .ac-invoice .ac-meta { width:100%; border-collapse:collapse; margin:0 0 16px; background:#faf8f5; }
    .ac-invoice .ac-meta td { width:50%; vertical-align:top; padding:10px 12px 5px; border:1px solid #e7e1da; overflow-wrap:break-word; }
    .ac-invoice .ac-meta small { color:#807680; font-size:9px; line-height:1.4; }
    .ac-invoice .ac-meta p, .ac-invoice .ac-meta [name='due_date'] { display:inline-block; width:48%; margin:0 1% 7px 0; vertical-align:top; line-height:1.4; font-size:11px; }
    .ac-invoice .ac-meta [name='due_date'] p { width:100%; margin:0; }
    .ac-invoice .ac-section { color:#4c153e; font-size:11px; font-weight:bold; padding-bottom:7px; margin-bottom:9px; border-bottom:1px solid #d9c8b2; }
    .ac-invoice table[name='invoice_line_table'] { font-size:10px; border-collapse:collapse; border-color:#e5dfe4; margin-bottom:0; }
    .ac-invoice table[name='invoice_line_table'] thead th { background:#4c153e !important; color:#fff !important; padding:9px 6px; vertical-align:middle; border:0; font-size:9.5px; line-height:1.4; }
    .ac-invoice table[name='invoice_line_table'] thead th * { color:#fff !important; }
    .ac-invoice table[name='invoice_line_table'] tbody td { padding:9px 6px; border:0; border-bottom:1px solid #e7e1da; vertical-align:top; font-size:11px; line-height:1.5; }
    .ac-invoice table[name='invoice_line_table'] tbody tr:nth-child(even) { background:#faf8f5; }
    .ac-invoice table[name='invoice_line_table'] .o_line_section td { background:#eee6eb !important; color:#4c153e; font-size:10px; padding:5px 6px; }
    .ac-invoice thead { display:table-header-group; }
    .ac-invoice tr { page-break-inside:avoid; }
    .ac-invoice #total { page-break-inside:avoid; }
    .ac-invoice #total .col-6 { width:60%; }
    .ac-invoice #total table td { padding:7px 9px; background:#fff !important; color:#39323c !important; border:0; border-bottom:1px solid #e7e1da; font-size:10.5px; line-height:1.4; }
    .ac-invoice #total .o_total td { background:#4c153e !important; color:#fff !important; font-size:12px; padding:10px 9px; }
    .ac-invoice #total .o_total td * { color:#fff !important; }
    .ac-invoice #total .oe_payment_label { font-size:10px; }
   </style>
  </xpath>
  <xpath expr="//div[hasclass('page')]/h3" position="after">
   <table class="ac-customer"><tr>
    <td style="width:72%;padding-right:18px;"><div class="ac-overline">BILL TO / بيانات العميل</div><t t-out="address"/></td>
    <td style="width:28%;text-align:right;"><t t-if="information_block" t-out="information_block"/></td>
   </tr></table>
  </xpath>
  <xpath expr="//th[@name='th_total']" position="replace"><th name="th_total" class="text-end">الإجمالي شامل الضريبة<br/>Total incl. VAT</th></xpath>
  <xpath expr="//th[@name='th_subtotal']" position="replace"><th name="th_subtotal" class="text-end">الصافي قبل الضريبة<br/>Net excl. VAT</th></xpath>
  <xpath expr="//th[@name='th_taxes']" position="replace"><th name="th_taxes" class="text-end">الضريبة<br/>VAT %</th></xpath>
  <xpath expr="//div[@id='informations']" position="replace">
   <div id="informations"><table class="ac-meta"><tr>
    <td>
     <div class="ac-section">Invoice Details <span style="float:right" dir="rtl">بيانات الفاتورة</span></div>
     <p t-if="o.invoice_date"><small>Invoice Date / تاريخ الفاتورة</small><br/><strong t-field="o.invoice_date"/></p>
     <div name="due_date" t-if="o.invoice_date_due"><small>Due Date / تاريخ الاستحقاق</small><p t-field="o.invoice_date_due"/></div>
     <p t-if="o.delivery_date"><small>Supply Date / تاريخ التوريد</small><br/><span t-field="o.delivery_date"/></p>
     <p t-if="o.invoice_origin"><small>Order / أمر البيع</small><br/><span t-field="o.invoice_origin"/></p>
     <p t-if="o.partner_id.ref"><small>Customer Code / كود العميل</small><br/><span t-field="o.partner_id.ref"/></p>
     <p t-if="o.ref"><small>Reference / المرجع</small><br/><span t-field="o.ref"/></p>
    </td>
    <td name="vehicle_block_info">
     <div class="ac-section">Vehicle Details <span style="float:right" dir="rtl">بيانات المركبة</span></div>
     <p t-if="o.vehicle_id"><small>Vehicle / المركبة</small><br/><strong t-field="o.vehicle_id"/></p>
     <p t-if="o.plate_numbers or o.plate_letters"><small>Plate Number / رقم اللوحة</small><br/><span t-field="o.plate_letters"/> &#160; <span t-field="o.plate_numbers"/></p>
     <p t-if="o.vehicle_vin_sn"><small>VIN / رقم الهيكل</small><br/><span t-field="o.vehicle_vin_sn"/></p>
     <p t-if="o.vehicle_color_id"><small>Color / اللون</small><br/><span t-field="o.vehicle_color_id"/></p>
     <p t-if="o.vehicle_model_year"><small>Model Year / سنة الصنع</small><br/><span t-field="o.vehicle_model_year"/></p>
     <p t-if="not o.vehicle_id"><small>Customer / العميل</small><br/><strong t-field="o.partner_id.name"/></p>
    </td>
   </tr></table></div>
  </xpath>
  <xpath expr="//i[hasclass('row')][.//div[hasclass('oe_payment_label')]]" position="replace">
   <div>Paid on / دُفع في<br/><span t-out="payment_vals['date']"/></div>
  </xpath>
 </template>
 <record id="account.account_invoices" model="ir.actions.report"><field name="paperformat_id" ref="account_move_print.paperformat_autochapeau"/></record>
 <record id="account.account_invoices_without_payment" model="ir.actions.report"><field name="paperformat_id" ref="account_move_print.paperformat_autochapeau"/></record>
</odoo>
