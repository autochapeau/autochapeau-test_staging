<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Smart buttons: Cars / Sales Orders / Reservations / ... -->
    <record id="view_partner_form_appointments" model="ir.ui.view">
        <field name="name">res.partner.form.appointments</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority" eval="50"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_partner_cars" type="object"
                    class="oe_stat_button" icon="fa-car" help="Cars">
                    <field name="cars_count" widget="statinfo" string="Cars"/>
                </button>
                <button
                    name="action_view_partner_sale_orders"
                    type="object" class="oe_stat_button"
                    icon="fa-usd" help="Sales Orders">
                    <field name="partner_sale_order_count" widget="statinfo" string="Sales Orders"/>
                </button>
                <button
                    name="action_view_appointments" type="object"
                    class="oe_stat_button" icon="fa-calendar" help="Reservations">
                    <field name="appointment_count" widget="statinfo" string="Reservations"/>
                </button>
                <button
                    name="action_view_checkins" type="object"
                    class="oe_stat_button" icon="fa-sign-in" help="Check-ins">
                    <field name="checkin_count" widget="statinfo" string="Check-ins"/>
                </button>
                <button
                    name="action_view_checkouts" type="object"
                    class="oe_stat_button" icon="fa-sign-out"
                    help="Checkouts">
                    <field name="checkout_count" widget="statinfo" string="Checkouts"/>
                </button>
                <button
                    name="action_view_workorders" type="object"
                    class="oe_stat_button" icon="fa-wrench" help="Work Orders">
                    <field name="workorder_count" widget="statinfo" string="Work Orders"/>
                </button>
                <button
                    name="action_view_payments" type="object"
                    class="oe_stat_button" icon="fa-money" help="Payments">
                    <field name="payment_count" widget="statinfo" string="Payments"/>
                </button>
                <button
                    name="action_view_invoices" type="object"
                    class="oe_stat_button" icon="fa-pencil-square-o" help="Invoices">
                    <field name="invoice_count" widget="statinfo" string="Invoices"/>
                </button>
            </div>
        </field>
    </record>

    <!-- Hide original Cars button from cars_management to avoid duplicate -->
    <record id="view_partner_form_hide_cars_mgmt_stat" model="ir.ui.view">
        <field name="name">res.partner.form.hide.cars.mgmt.stat</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="cars_management.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_cars']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Form body action buttons (same actions as smart buttons) -->
    <record id="view_partner_form_action_buttons" model="ir.ui.view">
        <field name="name">res.partner.form.action.buttons</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@name='button_box']" position="after">
                <div class="d-flex flex-wrap gap-1 mb-3" invisible="not id">
                    <button name="action_view_partner_cars"
                            type="object"
                            string="Cars"
                            class="btn btn-primary"
                            icon="fa-car"/>
                    <button name="action_view_partner_sale_orders"
                            type="object"
                            string="Sales Orders"
                            class="btn btn-success"
                            icon="fa-usd"/>
                    <button name="action_view_appointments"
                            type="object"
                            string="Reservations"
                            class="btn btn-info"
                            icon="fa-calendar"/>
                    <button name="action_view_checkins"
                            type="object"
                            string="Check-ins"
                            class="btn btn-warning"
                            icon="fa-sign-in"/>
                    <button name="action_view_checkouts"
                            type="object"
                            string="Checkouts"
                            class="btn btn-secondary"
                            icon="fa-sign-out"/>
                    <button name="action_view_workorders"
                            type="object"
                            string="Work Orders"
                            class="btn btn-dark"
                            icon="fa-wrench"/>
                    <button name="action_view_payments"
                            type="object"
                            string="Payments"
                            class="btn btn-danger"
                            icon="fa-money"/>
                    <button name="action_view_invoices"
                            type="object"
                            string="Invoices"
                            class="btn btn-outline-primary"
                            icon="fa-pencil-square-o"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Contact partner type -->
    <record id="view_partner_form_inherit_partner_type" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.partner.type</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="contact_partner_type"/>
            </xpath>
        </field>
    </record>

    <record id="partner_customer_action" model="ir.actions.act_window">
        <field name="name">Client</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('contact_partner_type', '=', 'customer')]</field>
        <field name="context">{'default_contact_partner_type': 'customer'}</field>
    </record>

    <record id="partner_customer_unverified_action" model="ir.actions.act_window">
        <field name="name">Unverified Clients</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[
            ('contact_partner_type', '=', 'customer'),
            ('mobile_verified', '=', False),
        ]</field>
        <field name="context">{
            'default_contact_partner_type': 'customer',
            'active_test': False,
            'default_mobile_verified': False,
        }</field>
    </record>

    <record id="partner_supplier_action" model="ir.actions.act_window">
        <field name="name">Supplier</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('contact_partner_type', '=', 'supplier')]</field>
        <field name="context">{'default_contact_partner_type': 'supplier'}</field>
    </record>

    <record id="partner_employee_action" model="ir.actions.act_window">
        <field name="name">Employee</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('contact_partner_type', '=', 'employee')]</field>
    </record>

    <menuitem id="menu_item_client_menu" name="Client"
              parent="contacts.menu_contacts"
              action="partner_customer_action" sequence="1"
              groups="partner_management.group_contact_customer"/>

    <menuitem id="menu_item_unverified_client_menu" name="Unverified Clients"
              parent="contacts.menu_contacts"
              action="partner_customer_unverified_action" sequence="2"
              groups="partner_management.group_contact_customer"/>

    <menuitem id="menu_item_supplier_menu" name="Supplier"
              parent="contacts.menu_contacts"
              action="partner_supplier_action" sequence="3"
              groups="partner_management.group_contact_supplier"/>

    <menuitem id="menu_item_employee_menu" name="Employee"
              parent="contacts.menu_contacts"
              action="partner_employee_action" sequence="4"/>

    <!-- Restrict standard "all contacts" menu to dedicated access group -->
    <record id="contacts.res_partner_menu_contacts" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('partner_management.group_contact_all')])]"/>
    </record>

    <!-- Restrict Contacts Configuration menu to dedicated access group -->
    <record id="contacts.res_partner_menu_config" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('partner_management.group_contact_configuration')])]"/>
    </record>

    <!-- City selection -->
    <record id="view_partner_form_inherit_city" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.city</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='city']" position="before">
                <field name="city_id"
                         domain="[('country_id', '=', country_id)]"
                         context="{'default_country_id': country_id}"
                         options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>
            <xpath expr="//field[@name='city']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Customer mobile OTP -->
    <record id="view_partner_form_customer_otp" model="ir.ui.view">
        <field name="name">res.partner.form.customer.otp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mobile']" position="after">
                <label for="mobile_otp_input"
                       invisible="contact_partner_type != 'customer' or partner_type == 'contract' or parent_id or supervisor_id or mobile_verified"/>
                <div class="o_row"
                     invisible="contact_partner_type != 'customer' or partner_type == 'contract' or parent_id or supervisor_id or mobile_verified">
                    <field name="mobile_otp_input" placeholder="Enter OTP"/>
                    <button name="action_send_mobile_otp"
                            type="object"
                            string="Send OTP"
                            class="btn-secondary"
                            invisible="contact_partner_type != 'customer' or partner_type == 'contract' or parent_id or supervisor_id or not mobile or mobile_verified"/>
                    <button name="action_send_mobile_otp"
                            type="object"
                            string="Resend OTP"
                            class="btn-link"
                            invisible="not id or contact_partner_type != 'customer' or partner_type == 'contract' or parent_id or supervisor_id or not mobile or mobile_verified"/>
                </div>
                <field name="mobile_verified" readonly="1" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Mobile verified: list column + search filters -->
    <record id="view_partner_tree_mobile_verified" model="ir.ui.view">
        <field name="name">res.partner.tree.mobile.verified</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="after">
                <field name="mobile_verified" optional="show" widget="boolean"/>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter_mobile_verified" model="ir.ui.view">
        <field name="name">res.partner.select.mobile.verified</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="before">
                <filter string="Mobile Verified" name="mobile_verified"
                        domain="[('mobile_verified', '=', True)]"/>
                <filter string="Mobile Not Verified" name="mobile_not_verified"
                        domain="[('mobile_verified', '=', False)]"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <!-- Subordinates / Supervisor: Contract → Internal only -->
    <record id="view_partner_form_inherit_subordinate" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.subordinate</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='contact_addresses']" position="after">
                <page string="Subordinates" name="subordinates"
                      invisible="partner_type not in ('contract', 'internal')">
                    <field name="subordinate_ids" mode="tree,form"
                             invisible="partner_type != 'contract'"
                             context="{
                                 'default_supervisor_id': id,
                                 'default_partner_type': 'internal',
                                 'default_type': 'contact',
                             }">
                        <tree>
                            <field name="name"/>
                            <field name="partner_type"/>
                            <field name="phone"/>
                            <field name="mobile"/>
                            <field name="email"/>
                        </tree>
                    </field>
                    <group string="Supervisor" invisible="partner_type != 'internal'">
                        <field name="supervisor_id"
                                 options="{'no_create': True, 'no_create_edit': True}"
                                 domain="[('partner_type', '=', 'contract'), ('id', '!=', id)]"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
