<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_journal_items_tree" model="ir.ui.view">
        <field name="name">account.move.line.tree.journal.items</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="mode">primary</field>
        <field name="priority" eval="110"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="invoice_user_id" optional="show" options="{'no_open': True}"/>
            </field>
            <field name="product_id" position="attributes">
                <attribute name="optional">show</attribute>
            </field>
            <field name="product_id" position="after">
                <field name="product_category_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="account.action_account_moves_all" model="ir.actions.act_window">
        <field name="view_id" ref="view_journal_items_tree"/>
    </record>
</odoo>
