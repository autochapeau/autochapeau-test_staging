<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="fleet_vehicle_view_tree_create_so" model="ir.ui.view">
        <field name="name">fleet.vehicle.tree.create.sale.order</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="cars_management.fleet_vehicle_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <header>
                    <button name="action_create_sale_order"
                            type="object"
                            string="Create Sale Order"
                            class="btn-primary"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_view_form_sale_orders" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.sale.orders</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="cars_management.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_sale_order"
                        type="object"
                        string="Create Sale Order"
                        class="btn-primary"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_sale_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        invisible="sale_order_count == 0">
                    <field name="sale_order_count"
                           widget="statinfo"
                           string="Sale Orders"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
