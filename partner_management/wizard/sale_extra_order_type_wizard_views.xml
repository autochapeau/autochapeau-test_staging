<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_sale_extra_order_type_wizard_form" model="ir.ui.view">
        <field name="name">sale.extra.order.type.wizard.form</field>
        <field name="model">sale.extra.order.type.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Extra Order">
                <div class="alert alert-info" role="alert">
                    Choose whether this Extra Order is Intern or Extern.
                    A Contract can have multiple linked Extra Orders.
                </div>
                <group>
                    <field name="sale_order_id" invisible="1"/>
                    <field name="order_type" widget="radio"/>
                </group>
                <footer>
                    <button name="action_continue"
                            type="object"
                            string="Continue"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
