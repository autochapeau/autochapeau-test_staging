<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_sale_order_confirm_otp_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.confirm.otp.wizard.form</field>
        <field name="model">sale.order.confirm.otp.wizard</field>
        <field name="arch" type="xml">
            <form string="Verify Customer Mobile">
                <group>
                    <field name="sale_order_id" invisible="1"/>
                    <field name="partner_id"/>
                    <field name="mobile"/>
                    <field name="country_id"/>
                    <field name="otp_code"/>
                </group>
                <footer>
                    <button name="action_send_otp"
                            type="object"
                            string="Send OTP"
                            class="btn-secondary"/>
                    <button name="action_verify_and_confirm"
                            type="object"
                            string="Verify and Confirm"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
