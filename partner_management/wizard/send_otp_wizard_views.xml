<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_partner_send_otp_wizard_form" model="ir.ui.view">
        <field name="name">partner.send.otp.wizard.form</field>
        <field name="model">partner.send.otp.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Mobile OTP">
                <group>
                    <field name="partner_id" invisible="1"/>
                    <field name="mobile"/>
                    <field name="country_id"/>
                </group>
                <footer>
                    <button name="action_send_otp" type="object" string="Send OTP" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_partner_send_otp_wizard" model="ir.actions.act_window">
        <field name="name">Send Mobile OTP</field>
        <field name="res_model">partner.send.otp.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_partner_send_otp_wizard_form"/>
    </record>
</odoo>
