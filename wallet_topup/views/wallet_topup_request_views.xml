<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wallet_topup_request_tree" model="ir.ui.view">
        <field name="name">wallet.topup.request.tree</field>
        <field name="model">wallet.topup.request</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0" default_order="id desc"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'pending'">
                <field name="name"/>
                <field name="create_date"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="payment_brand"/>
                <field name="transaction_id"/>
                <field name="state"/>
                <field name="payment_id" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_wallet_topup_request_form" model="ir.ui.view">
        <field name="name">wallet.topup.request.form</field>
        <field name="model">wallet.topup.request</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="amount"/>
                            <field name="payment_brand"/>
                            <field name="create_date"/>
                        </group>
                        <group>
                            <field name="transaction_id"/>
                            <field name="payment_id"/>
                            <field name="wallet_card_id"/>
                            <field name="exchange_log_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wallet_topup_request" model="ir.actions.act_window">
        <field name="name">Website Wallet Top-ups</field>
        <field name="res_model">wallet.topup.request</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_wallet_topup_root"
        name="Wallet Top-up"
        parent="sale.sale_menu_root"
        sequence="55"/>

    <menuitem
        id="menu_wallet_topup_request"
        name="Website Top-ups"
        parent="menu_wallet_topup_root"
        action="action_wallet_topup_request"
        sequence="10"/>
</odoo>
