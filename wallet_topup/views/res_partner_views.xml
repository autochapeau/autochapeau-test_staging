<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_wallet_topup_button" model="ir.ui.view">
        <field name="name">res.partner.form.wallet.topup.button</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="partner_management.view_partner_form_action_buttons"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_invoices']" position="after">
                <button
                    name="action_open_wallet_topup"
                    type="object"
                    string="Wallet Top-up"
                    class="btn btn-outline-success"
                    icon="fa-plus-circle"/>
            </xpath>
        </field>
    </record>
</odoo>
