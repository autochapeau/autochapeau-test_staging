<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="loyalty_card_view_form_wallet_topup" model="ir.ui.view">
        <field name="name">loyalty.card.form.wallet.topup</field>
        <field name="model">loyalty.card</field>
        <field name="inherit_id" ref="loyalty.loyalty_card_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="program_type" invisible="1"/>
                <button
                    name="action_open_wallet_topup"
                    type="object"
                    string="Top-up Wallet"
                    class="btn btn-primary"
                    icon="fa-plus"
                    invisible="program_type != 'ewallet'"
                    colspan="2"/>
            </xpath>
        </field>
    </record>
</odoo>
