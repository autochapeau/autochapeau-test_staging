<templates xml:space="preserve">
 <t t-name="sales_region_commission.Dashboard">
  <div class="cs-dashboard" t-att-aria-busy="state.loading ? 'true' : 'false'">
   <div class="cs-toolbar">
    <div class="cs-brand"><img class="cs-brand-icon" src="/sales_region_commission/static/description/icon.png" alt="Commission Studio"/><div><strong>COMMISSION STUDIO</strong><small>Performance, with clarity.</small></div></div>
    <div class="cs-controls"><label>View<select aria-label="Calendar period" t-att-value="state.period" t-on-change="changePeriod"><option value="month">Monthly</option><option value="quarter">Quarterly</option><option value="half">Half-yearly</option><option value="year">Yearly</option></select></label><label>Period<input aria-label="Period" type="month" t-att-value="state.month" t-on-change="changeMonth"/></label><label>Region / team<select aria-label="Region or team" t-att-value="state.team" t-on-change="changeTeam"><option value="">All accessible teams</option><t t-foreach="state.data?.teams || []" t-as="team" t-key="team.id"><option t-att-value="team.id" t-esc="team.name"/></t></select></label><button class="cs-refresh" title="Refresh dashboard" aria-label="Refresh dashboard" t-on-click="load" t-att-disabled="state.loading"><i t-att-class="state.loading ? 'fa fa-refresh fa-spin' : 'fa fa-refresh'"/></button></div>
   </div>
   <div t-if="state.error" class="alert alert-danger" role="alert"><t t-esc="state.error"/><button class="btn btn-link" t-on-click="load">Try again</button></div>
   <t t-if="state.data">
    <section class="cs-hero"><div class="cs-hero-copy"><span class="cs-eyebrow"><i class="fa fa-circle"/> POSTED INVOICES · VERIFIED SCOPE</span><h1><t t-if="state.data.personal">Your work.<br/>Your rewards.</t><t t-else="">A clear view.<br/>A stronger team.</t></h1><p>From every posted invoice to every earned commission.<br/>Returns included. Your scope respected.</p><div class="cs-hero-actions"><button t-on-click="() => this.openLedger()">Explore the ledger <i class="fa fa-arrow-right"/></button><span><i class="fa fa-lock"/> <t t-if="state.data.personal">Only your commissions</t><t t-else="">Your authorized regions</t></span></div></div><div class="cs-hero-total"><span>NET COMMISSION</span><div><t t-esc="money(state.data.commission)"/></div><small t-esc="state.data.currency"/><p><i class="fa fa-check-circle"/> Rates captured at posting</p></div><div class="cs-orbit cs-orbit-one"/><div class="cs-orbit cs-orbit-two"/></section>
    <div class="cs-kpis"><article><span class="cs-kpi-icon"><i class="fa fa-file-text-o"/></span><label>Net invoiced</label><strong><t t-esc="money(state.data.net)"/></strong><small><t t-esc="state.data.currency"/> · after discounts, before tax</small></article><article><span class="cs-kpi-icon amber"><i class="fa fa-undo"/></span><label>Credit note impact</label><strong><t t-esc="money(state.data.refunds)"/></strong><small>Net reductions in this period</small></article><article><span class="cs-kpi-icon blue"><i class="fa fa-bullseye"/></span><label>Period target</label><strong><t t-if="state.data.target" t-esc="money(state.data.target)"/><t t-else="">Not set</t></strong><small t-if="state.data.personal">Your contribution to the team target</small><small t-else="">Parent targets counted once</small></article><button class="cs-review-kpi" t-on-click="openReview"><span class="cs-kpi-icon rose"><i class="fa fa-flag-o"/></span><label>Needs review</label><strong t-esc="state.data.review"/><small>Missing rule or invoice attribution <i class="fa fa-arrow-right"/></small></button></div>
    <div class="cs-main-grid"><section class="cs-panel cs-trend"><div class="cs-panel-heading"><div><span class="cs-overline">THE PERIOD IN MOTION</span><h2>Net invoiced activity</h2></div><span class="cs-pill"><i class="fa fa-circle"/> Posted lines</span></div><t t-if="state.data.daily.length"><div class="cs-chart" role="img" aria-label="Daily net invoiced activity; values available in the ledger"><t t-foreach="state.data.daily" t-as="day" t-key="day.label"><div class="cs-chart-column" t-att-title="day.label + ': ' + money(day.net) + ' ' + state.data.currency"><div t-att-class="day.net &lt; 0 ? 'cs-bar negative' : 'cs-bar'" t-att-style="barStyle(day)"/></div></t></div><div class="cs-chart-footer"><span>Invoice date</span><span>Hover for daily values · <t t-esc="state.data.currency"/></span></div></t><div t-else="" class="cs-empty"><i class="fa fa-bar-chart"/><h3>A fresh start for this period</h3><p>Posted invoices will appear here once commission tracking begins.</p></div></section>
    <section class="cs-panel cs-target"><span class="cs-overline">MAKE PROGRESS VISIBLE</span><h2>Target achievement</h2><div class="cs-ring" t-att-style="ringStyle"><div><strong><t t-if="state.data.target"><t t-esc="percent"/>%</t><t t-else="">—</t></strong><small t-if="state.data.personal">Your contribution</small><small t-else="">of period target</small></div></div><p t-if="state.data.target"><strong t-esc="money(Math.max(0, state.data.target - state.data.net))"/> <t t-esc="state.data.currency"/> remaining</p><p t-else="">Set a sales target to track progress.</p><button class="cs-text-button" t-on-click="openTargets">View targets <i class="fa fa-arrow-right"/></button></section></div>
    <section class="cs-panel cs-leaderboard"><div class="cs-panel-heading"><div><span class="cs-overline">PEOPLE BEHIND THE NUMBERS</span><h2 t-if="state.data.personal">Your commission summary</h2><h2 t-else="">Salesperson performance</h2></div><button class="cs-text-button" t-on-click="() => this.openLedger()">All entries <i class="fa fa-arrow-right"/></button></div><div class="cs-table-wrap"><table t-if="state.data.people.length"><thead><tr><th>Salesperson</th><th>Net invoiced</th><th>Commission</th><th>Relative contribution</th><th><span class="visually-hidden">Details</span></th></tr></thead><tbody><t t-foreach="state.data.people" t-as="person" t-key="person.id || 'unassigned'"><tr><td><span class="cs-avatar" t-esc="person.name.substring(0, 1)"/><strong t-esc="person.name"/></td><td t-esc="money(person.net)"/><td class="cs-table-amount" t-esc="money(person.amount)"/><td><div class="cs-person-track"><span t-att-style="personStyle(person)"/></div></td><td><button class="cs-row-link" t-att-aria-label="'View entries for ' + person.name" t-on-click="() => this.openPerson(person)"><i class="fa fa-arrow-right"/></button></td></tr></t></tbody></table><div t-else="" class="cs-empty cs-empty-small"><h3>No commission entries yet</h3><p>Choose another period or ask your administrator to configure rates.</p><button t-if="state.admin" class="cs-text-button" t-on-click="openRules">Configure commission rules <i class="fa fa-arrow-right"/></button></div></div></section>
    <footer class="cs-footer"><span><i class="fa fa-shield"/> Access controlled on the server</span><span><t t-esc="state.data.count"/> tracked invoice lines · <t t-esc="state.data.currency"/> · Achievement tiers use the assigned individual target</span></footer>
   </t>
   <div t-elif="state.loading" class="cs-loading" role="status"><i class="fa fa-circle-o-notch fa-spin"/><p>Preparing your commission overview…</p></div>
  </div>
 </t>
</templates>
