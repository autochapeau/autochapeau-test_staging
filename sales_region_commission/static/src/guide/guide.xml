<templates xml:space="preserve">
 <t t-name="sales_region_commission.Guide">
  <div class="cs-guide" t-att-dir="state.lang === 'ar' ? 'rtl' : 'ltr'">
   <header class="cs-guide-masthead"><div class="cs-guide-wordmark"><img src="/sales_region_commission/static/description/icon.png" alt="Commission Studio"/><span>COMMISSION STUDIO <b>/ GUIDE</b></span></div><div class="cs-guide-languages" aria-label="Guide language"><button t-att-class="state.lang === 'ar' ? 'is-active' : ''" t-on-click="() => this.state.lang = 'ar'">العربية</button><button t-att-class="state.lang === 'en' ? 'is-active' : ''" t-on-click="() => this.state.lang = 'en'">English</button></div></header>
   <section class="cs-guide-hero"><span class="cs-guide-eyebrow">THE WORKSPACE HANDBOOK</span><h1 t-esc="text('من أول الإعداد… لحد كل عمولة.', 'From first setup to every commission.')"/><p t-esc="text('دليلك المصوّر للتطبيق. اختار الشاشة، افهم الخطوات، وابدأ الشغل بثقة.', 'Your visual guide to the app. Choose a screen, follow the steps and get to work.')"/><div class="cs-guide-pills"><span><i class="fa fa-camera"/> <t t-esc="text('صور فعلية من نسخة QA', 'Real QA screenshots')"/></span><span><i class="fa fa-shield"/> <t t-esc="text('شرح حسب صلاحيتك', 'Guidance for your role')"/></span><span><i class="fa fa-language"/> عربي / English</span></div></section>
   <nav class="cs-guide-topics" t-att-aria-label="text('موضوعات الدليل', 'Guide topics')"><button t-foreach="topics" t-as="entry" t-key="entry.id" t-att-class="entry.id === topic.id ? 'is-active' : ''" t-att-aria-current="entry.id === topic.id ? 'page' : undefined" t-on-click="() => this.select(entry)"><i t-att-class="icon(entry)"/><span t-esc="tr(entry.label)"/></button></nav>
   <article t-if="topic" class="cs-guide-article" t-att-aria-label="tr(topic.title)">
    <div class="cs-guide-article-heading"><div><span class="cs-guide-chapter"><bdi dir="ltr"><t t-esc="number(currentIndex + 1)"/> / <t t-esc="number(topics.length)"/></bdi> — <t t-esc="tr(topic.label)"/></span><h2 t-esc="tr(topic.title)"/><p t-esc="tr(topic.intro)"/></div><button class="cs-guide-open" t-on-click="open"><t t-esc="text('افتح الشاشة', 'Open screen')"/><i class="fa fa-external-link"/></button></div>
    <div class="cs-guide-content"><div class="cs-guide-instructions"><ol><li t-foreach="topic.steps" t-as="step" t-key="step_index"><span t-esc="step_index + 1"/><p t-esc="tr(step)"/></li></ol><aside class="cs-guide-tip"><i class="fa fa-lightbulb-o"/><div><strong t-esc="text('خد بالك', 'Good to know')"/><p t-esc="tr(topic.tip)"/></div></aside></div><figure><button class="cs-guide-screen" t-att-aria-label="text('تكبير صورة الشاشة', 'Enlarge screenshot')" t-on-click="enlarge"><img t-att-src="image(topic)" t-att-alt="tr(topic.title)"/><span><i class="fa fa-expand"/> <t t-esc="text('اضغط للتكبير', 'Click to enlarge')"/></span></button><figcaption><i class="fa fa-info-circle"/> <t t-esc="text('بيانات تجريبية للتوضيح. الأرقام والنسب دي مش إعدادات شغلك الفعلية.', 'Illustrative QA data. These amounts and rates are not your live business configuration.')"/></figcaption></figure></div>
    <footer class="cs-guide-footer"><span><i class="fa fa-check-circle"/> <t t-esc="text('القوائم والبيانات بتتحدد حسب دورك والشركات المسموح بيها.', 'Menus and data follow your role and allowed companies.')"/></span><button t-on-click="next"><t t-esc="text('الموضوع التالي', 'Next topic')"/><i t-att-class="state.lang === 'ar' ? 'fa fa-arrow-left' : 'fa fa-arrow-right'"/></button></footer>
   </article>
  </div>
 </t>
<t t-name="sales_region_commission.GuideScreenshot"><Dialog title="props.title" size="'xl'" footer="false" bodyClass="'cs-guide-image-dialog'"><img t-att-src="props.src" t-att-alt="props.title"/></Dialog></t>
</templates>
