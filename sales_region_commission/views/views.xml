<odoo>
 <record id="entry_tree" model="ir.ui.view"><field name="name">sales.commission.entry.tree</field><field name="model">sales.commission.entry</field><field name="arch" type="xml"><tree create="0" edit="0" delete="0" decoration-warning="status == 'review'" decoration-danger="base &lt; 0"><field name="date"/><field name="move_id"/><field name="user_id"/><field name="team_id"/><field name="product_id"/><field name="category_name"/><field name="currency_id" column_invisible="True"/><field name="base" sum="Net invoiced"/><field name="rate"/><field name="amount" sum="Commission"/><field name="status" widget="badge"/><field name="note" optional="hide"/></tree></field></record>
 <record id="entry_form" model="ir.ui.view"><field name="name">sales.commission.entry.form</field><field name="model">sales.commission.entry</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><sheet><h1>Commission audit</h1><group><group><field name="move_id"/><field name="invoice_line_id"/><field name="date"/><field name="user_id"/><field name="team_id"/><field name="product_id"/><field name="category_name"/></group><group><field name="company_id"/><field name="currency_id"/><field name="base"/><field name="rate"/><field name="amount"/><field name="rule_id"/><field name="origin_id"/><field name="status"/><field name="note"/></group></group></sheet></form></field></record>
 <record id="entry_search" model="ir.ui.view"><field name="name">sales.commission.entry.search</field><field name="model">sales.commission.entry</field><field name="arch" type="xml"><search><field name="user_id"/><field name="team_id"/><field name="move_id"/><field name="product_id"/><filter name="review" string="Needs review" domain="[('status','=','review')]"/><filter name="refund" string="Credit notes" domain="[('base','&lt;',0)]"/><filter name="date" date="date"/><group expand="0" string="Group by"><filter name="person" string="Salesperson" context="{'group_by':'user_id'}"/><filter name="team" string="Team" context="{'group_by':'team_id'}"/><filter name="month" string="Month" context="{'group_by':'date:month'}"/></group></search></field></record>
 <record id="entry_pivot" model="ir.ui.view"><field name="name">sales.commission.entry.pivot</field><field name="model">sales.commission.entry</field><field name="arch" type="xml"><pivot string="Commission analysis"><field name="user_id" type="row"/><field name="date" type="col" interval="month"/><field name="base" type="measure"/><field name="amount" type="measure"/></pivot></field></record>
 <record id="entry_action" model="ir.actions.act_window"><field name="name">Commission ledger</field><field name="res_model">sales.commission.entry</field><field name="view_mode">tree,pivot,form</field></record>
 <record id="rule_tree" model="ir.ui.view"><field name="name">sales.commission.rule.tree</field><field name="model">sales.commission.rule</field><field name="arch" type="xml"><tree><field name="name"/><field name="user_id"/><field name="kind"/><field name="category_id"/><field name="service_category_id"/><field name="rate"/><field name="date_from"/><field name="date_to"/><field name="company_id" groups="base.group_multi_company"/></tree></field></record>
 <record id="rule_form" model="ir.ui.view"><field name="name">sales.commission.rule.form</field><field name="model">sales.commission.rule</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="active"/><field name="company_id"/><field name="user_id"/><field name="kind"/><field name="category_id" invisible="kind != 'product'" required="kind == 'product'"/><field name="service_category_id" invisible="kind != 'service'" required="kind == 'service'"/><field name="rate"/><field name="date_from"/><field name="date_to"/></group><div class="alert alert-info">Rates apply to the exact category, after discounts and excluding tax. Posted entries preserve their original rate. Targets do not change rates.</div></sheet></form></field></record>
 <record id="rule_action" model="ir.actions.act_window"><field name="name">Commission rules</field><field name="res_model">sales.commission.rule</field><field name="view_mode">tree,form</field></record>
 <record id="target_tree" model="ir.ui.view"><field name="name">sales.commission.target.tree</field><field name="model">sales.commission.target</field><field name="arch" type="xml"><tree editable="bottom"><field name="company_id"/><field name="team_id"/><field name="month"/><field name="currency_id" column_invisible="True"/><field name="amount"/></tree></field></record>
 <record id="target_action" model="ir.actions.act_window"><field name="name">Monthly targets</field><field name="res_model">sales.commission.target</field><field name="view_mode">tree,form</field></record>
 <record id="team_form" model="ir.ui.view"><field name="name">Commission region setup</field><field name="model">crm.team</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="company_id"/><field name="commission_level"/><field name="commission_parent_id"/><field name="commission_manager_id"/><field name="user_id"/><field name="member_company_ids" invisible="1"/><field name="member_ids" widget="many2many_tags"/></group></sheet></form></field></record>
 <record id="team_action" model="ir.actions.act_window"><field name="name">Regions and teams</field><field name="res_model">crm.team</field><field name="view_mode">tree,form</field><field name="view_id" ref="sales_team.crm_team_view_tree"/></record>
 <record id="team_action_tree" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">tree</field><field name="view_id" ref="sales_team.crm_team_view_tree"/><field name="act_window_id" ref="team_action"/></record>
 <record id="team_action_form" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="team_form"/><field name="act_window_id" ref="team_action"/></record>
 <record id="dashboard_action" model="ir.actions.client"><field name="name">Commission Studio</field><field name="tag">sales_region_commission.dashboard</field></record>
 <menuitem id="menu_root" name="Commission Studio" sequence="35" groups="group_user" action="dashboard_action" web_icon="sales_region_commission,static/description/icon.png"/>
 <menuitem id="menu_dashboard" name="Overview" parent="menu_root" action="dashboard_action" sequence="1" groups="group_user"/>
 <menuitem id="menu_ledger" name="Commission ledger" parent="menu_root" action="entry_action" sequence="2" groups="group_user"/>
 <menuitem id="menu_targets" name="Monthly targets" parent="menu_root" action="target_action" sequence="3" groups="group_user"/>
 <menuitem id="menu_rules" name="Commission rules" parent="menu_root" action="rule_action" sequence="4" groups="group_user"/>
 <menuitem id="menu_teams" name="Regions and teams" parent="menu_root" action="team_action" sequence="5" groups="group_admin"/>
<record id="calculate_form" model="ir.ui.view"><field name="name">sales.commission.calculate.form</field><field name="model">sales.commission.calculate</field><field name="arch" type="xml"><form string="Calculate posted commissions"><div class="alert alert-info">Configure dated rules first. This calculates missing entries and retries review entries only. Existing calculated rates remain unchanged. Customer invoices are processed before their credit notes. No invoice amounts or accounting entries are modified.</div><group><field name="company_id"/><field name="date_from"/><field name="date_to"/><field name="retry_review"/></group><footer><button name="action_calculate" type="object" string="Calculate" class="btn-primary"/><button special="cancel" string="Cancel"/></footer></form></field></record>
<record id="calculate_action" model="ir.actions.act_window"><field name="name">Calculate posted commissions</field><field name="res_model">sales.commission.calculate</field><field name="view_mode">form</field><field name="target">new</field></record>
<menuitem id="menu_calculate" name="Calculate posted commissions" parent="menu_root" action="calculate_action" sequence="6" groups="group_admin"/>
<record id="service_category_action" model="ir.actions.act_window"><field name="name">Service categories</field><field name="res_model">commission.category</field><field name="view_mode">tree,form</field></record>
<menuitem id="menu_service_category" name="Service categories" parent="menu_root" action="service_category_action" sequence="7" groups="group_admin"/>
</odoo>
