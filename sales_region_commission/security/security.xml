<odoo>
<record id="module_category" model="ir.module.category"><field name="name">Sales Commission Studio</field><field name="sequence">25</field></record>
  <record id="group_user" model="res.groups"><field name="name">Commission: Own dashboard</field><field name="category_id" ref="module_category"/><field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/></record>
  <record id="group_manager" model="res.groups"><field name="name">Commission: Region manager</field><field name="category_id" ref="module_category"/><field name="implied_ids" eval="[(4, ref('group_user'))]"/></record>
  <record id="group_admin" model="res.groups"><field name="name">Commission: Administrator</field><field name="category_id" ref="module_category"/><field name="implied_ids" eval="[(4, ref('group_manager'))]"/></record>
  <record id="entry_company" model="ir.rule"><field name="name">Commission company isolation</field><field name="model_id" ref="model_sales_commission_entry"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
  <record id="entry_own" model="ir.rule"><field name="name">Own commissions</field><field name="model_id" ref="model_sales_commission_entry"/><field name="groups" eval="[(4,ref('group_user'))]"/><field name="domain_force">[('user_id','=',user.id)]</field></record>
  <record id="entry_region" model="ir.rule"><field name="name">Managed region commissions</field><field name="model_id" ref="model_sales_commission_entry"/><field name="groups" eval="[(4,ref('group_manager'))]"/><field name="domain_force">[('team_id','in',user.commission_visible_team_ids())]</field></record>
  <record id="entry_admin" model="ir.rule"><field name="name">All commissions</field><field name="model_id" ref="model_sales_commission_entry"/><field name="groups" eval="[(4,ref('group_admin'))]"/><field name="domain_force">[(1,'=',1)]</field></record>
  <record id="rule_company" model="ir.rule"><field name="name">Rate company isolation</field><field name="model_id" ref="model_sales_commission_rule"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
  <record id="rule_own" model="ir.rule"><field name="name">Own rates</field><field name="model_id" ref="model_sales_commission_rule"/><field name="groups" eval="[(4,ref('group_user'))]"/><field name="domain_force">[('user_id','=',user.id)]</field></record>
  <record id="rule_admin" model="ir.rule"><field name="name">All rates</field><field name="model_id" ref="model_sales_commission_rule"/><field name="groups" eval="[(4,ref('group_admin'))]"/><field name="domain_force">[(1,'=',1)]</field></record>
  <record id="target_company" model="ir.rule"><field name="name">Target company isolation</field><field name="model_id" ref="model_sales_commission_target"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
  <record id="target_own" model="ir.rule"><field name="name">Own team targets</field><field name="model_id" ref="model_sales_commission_target"/><field name="groups" eval="[(4,ref('group_user'))]"/><field name="domain_force">['|','|',('team_id.member_ids','in',[user.id]),('team_id.user_id','=',user.id),('team_id.commission_manager_id','=',user.id)]</field></record>
  <record id="target_region" model="ir.rule"><field name="name">Managed region targets</field><field name="model_id" ref="model_sales_commission_target"/><field name="groups" eval="[(4,ref('group_manager'))]"/><field name="domain_force">[('team_id','in',user.commission_visible_team_ids())]</field></record>
  <record id="target_admin" model="ir.rule"><field name="name">All targets</field><field name="model_id" ref="model_sales_commission_target"/><field name="groups" eval="[(4,ref('group_admin'))]"/><field name="domain_force">[(1,'=',1)]</field></record>
</odoo>
