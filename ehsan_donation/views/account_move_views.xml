<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_ehsan_donation" model="ir.ui.view">
        <field name="name">account.move.form.inherit.ehsan.donation</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="company_ehsan_donation_amount"
                       invisible="move_type != 'out_invoice' or not company_ehsan_donation_amount"/>
                <field name="company_ehsan_donation_move_id"
                       invisible="move_type != 'out_invoice' or not company_ehsan_donation_move_id"/>
                <field name="company_ehsan_donation_state" invisible="1"/>
            </xpath>
            <!-- Keep Label/Description visible so donation text shows without a product. -->
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='name']" position="attributes">
                <attribute name="optional">show</attribute>
                <attribute name="string">Label</attribute>
            </xpath>
        </field>
    </record>
</odoo>
