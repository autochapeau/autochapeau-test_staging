<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_ehsan_donation_invoice_tree" model="ir.ui.view">
        <field name="name">account.move.tree.company.ehsan.donation</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <tree create="0" delete="0" edit="0">
                <field name="name"/>
                <field name="invoice_date"/>
                <field name="partner_id"/>
                <field name="amount_untaxed" sum="Untaxed Total"/>
                <field name="amount_total" optional="hide"/>
                <field name="company_ehsan_donation_amount" sum="Total Company Donations"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_ehsan_donation_move_id"/>
                <field name="company_ehsan_donation_state"
                       widget="badge"
                       decoration-warning="company_ehsan_donation_state == 'pending'"
                       decoration-success="company_ehsan_donation_state == 'posted'"/>
                <field name="payment_state" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_company_ehsan_donation_invoice_search" model="ir.ui.view">
        <field name="name">account.move.search.company.ehsan.donation</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="company_ehsan_donation_move_id"/>
                <filter name="pending" string="Pending Journal"
                        domain="[('company_ehsan_donation_state', '=', 'pending')]"/>
                <filter name="posted" string="Posted"
                        domain="[('company_ehsan_donation_state', '=', 'posted')]"/>
                <separator/>
                <filter name="filter_date" string="Invoice Date" date="invoice_date"/>
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Customer"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Donation Status"
                            context="{'group_by': 'company_ehsan_donation_state'}"/>
                    <filter name="group_date" string="Invoice Date"
                            context="{'group_by': 'invoice_date:month'}"/>
                    <filter name="group_company" string="Company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_company_ehsan_donation_invoice_pivot" model="ir.ui.view">
        <field name="name">account.move.pivot.company.ehsan.donation</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <pivot string="Company Ehsan Donations">
                <field name="invoice_date" type="row" interval="month"/>
                <field name="company_ehsan_donation_state" type="col"/>
                <field name="company_ehsan_donation_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_company_ehsan_donation_invoice_graph" model="ir.ui.view">
        <field name="name">account.move.graph.company.ehsan.donation</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <graph string="Company Ehsan Donations" type="bar">
                <field name="invoice_date" interval="month"/>
                <field name="company_ehsan_donation_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_company_ehsan_donation_report" model="ir.actions.act_window">
        <field name="name">Company Ehsan Donations</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,pivot,graph,form</field>
        <field name="domain">[('company_ehsan_donation_amount', '>', 0)]</field>
        <field name="search_view_id" ref="view_company_ehsan_donation_invoice_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No company Ehsan donations yet
            </p>
            <p>
                Paid sales whose invoices reach the configured threshold will appear here,
                including sales split into smaller invoices.
            </p>
        </field>
    </record>

    <record id="action_company_ehsan_donation_report_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_company_ehsan_donation_invoice_tree"/>
        <field name="act_window_id" ref="action_company_ehsan_donation_report"/>
    </record>
    <record id="action_company_ehsan_donation_report_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_company_ehsan_donation_invoice_pivot"/>
        <field name="act_window_id" ref="action_company_ehsan_donation_report"/>
    </record>
    <record id="action_company_ehsan_donation_report_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_company_ehsan_donation_invoice_graph"/>
        <field name="act_window_id" ref="action_company_ehsan_donation_report"/>
    </record>

    <menuitem id="menu_company_ehsan_donation_report"
              name="Company Ehsan Donations"
              parent="sale.menu_sale_report"
              action="action_company_ehsan_donation_report"
              groups="account.group_account_invoice,sales_team.group_sale_salesman"
              sequence="51"/>
</odoo>
