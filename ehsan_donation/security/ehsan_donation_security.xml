<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_cancel_ehsan_donation" model="res.groups">
        <field name="name">Cancel Ehsan Donation</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="comment">Allow cancelling a customer Ehsan donation entered by mistake (before journal posting / paid invoice).</field>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="sales_team.group_sale_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_cancel_ehsan_donation'))]"/>
    </record>
</odoo>
