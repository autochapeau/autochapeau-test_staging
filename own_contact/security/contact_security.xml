<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_own_contact" model="ir.module.category">
        <field name="name">Own Contact</field>
        <field name="sequence">25</field>
    </record>
    <record id="group_own_contact" model="res.groups">
        <field name="name">Own Contact</field>
        <field name="category_id" ref="module_category_own_contact"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_all_contacts" model="res.groups">
        <field name="name">All Contacts (Manager)</field>
        <field name="category_id" ref="module_category_own_contact"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <!-- Global conditional rules prevent permissive group rules from widening access.
         Internal user/company partners stay readable for Odoo's core relations. -->
    <record id="rule_own_contact_read" model="ir.rule">
        <field name="name">Own Contact: read own and system contacts</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">['|', '|', ('user_id', '=', user.id), ('partner_share', '=', False), ('id', 'in', user.company_ids.partner_id.ids)] if user.has_group('own_contact.group_own_contact') and not user.has_group('own_contact.group_all_contacts') else [(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_own_contact_modify" model="ir.rule">
        <field name="name">Own Contact: create and delete own contacts</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('id', '=', user.partner_id.id)] if user.has_group('own_contact.group_own_contact') and not user.has_group('own_contact.group_all_contacts') else [(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <!-- res.users delegates to res.partner. Its write rule also includes the
         partner write domain, even when only user groups are being changed.
         Keep Settings administrators able to manage internal user accounts;
         standard user ACLs/field restrictions still apply. This exception does
         not grant delete access, or write access to unrelated customer records. -->
    <record id="rule_own_contact_write" model="ir.rule">
        <field name="name">Own Contact: write own contacts and administer internal users</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">(
            ['|', '|', ('user_id', '=', user.id), ('id', '=', user.partner_id.id), ('partner_share', '=', False)]
            if user.has_group('base.group_system') else
            ['|', ('user_id', '=', user.id), ('id', '=', user.partner_id.id)]
            ) if user.has_group('own_contact.group_own_contact') and not user.has_group('own_contact.group_all_contacts') else [(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_all_contacts" model="ir.rule">
        <field name="name">Own Contact: manager all contacts</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('group_all_contacts'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
