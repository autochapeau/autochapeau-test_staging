<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="portal_home_loyalty_view_tree" model="ir.ui.view">
        <field name="name">portal.home.loyalty.tree</field>
        <field name="model">portal.home.loyalty</field>
        <field name="arch" type="xml">
            <tree>
                <field name="title" />
                <field name="small_title" />
                <field name="button_label" />
            </tree>
        </field>
    </record>

    <record id="portal_home_loyalty_view_form" model="ir.ui.view">
        <field name="name">portal.home.loyalty.form</field>
        <field name="model">portal.home.loyalty</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="small_title" />
                            <field name="title" />
                            <field name="description" />
                            <field name="subtitle" />
                            <field name="button_label" />
                            <field name="button_url" widget="url" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Items">
                            <field name="item_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                </tree>
                            </field>
                        </page>
                        <page string="Images">
                            <field name="image_ids">
                                <tree>
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                </tree>
                                <form>
                                    <group>
                                        <field name="name" />
                                        <field
                                            name="image_1920"
                                            string="Image"
                                            widget="image"
                                            options='{"zoom": true, "preview_image": "image_128"}'
                                        />
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="portal_home_loyalty_action" model="ir.actions.act_window">
        <field name="name">Loyalty Section</field>
        <field name="res_model">portal.home.loyalty</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem
        id="portal_home_loyalty_menu"
        name="Loyalty Section"
        parent="portal_home_menu_root"
        action="portal_home_loyalty_action"
        sequence="3"
    />

</odoo>
