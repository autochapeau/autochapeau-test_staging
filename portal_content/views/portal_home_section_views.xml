<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="portal_home_section_view_tree" model="ir.ui.view">
        <field name="name">portal.home.section.tree</field>
        <field name="model">portal.home.section</field>
        <field name="arch" type="xml">
            <tree>
                <field name="title" />
                <field name="small_title" />
                <field name="video_url" />
            </tree>
        </field>
    </record>

    <record id="portal_home_section_view_form" model="ir.ui.view">
        <field name="name">portal.home.section.form</field>
        <field name="model">portal.home.section</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="small_title" />
                            <field name="title" />
                            <field name="description" />
                            <field name="video_url" widget="url" />
                        </group>
                        <group>
                            <field
                                name="image_1920"
                                string="Video Thumbnail"
                                widget="image"
                                options='{"zoom": true, "preview_image": "image_128"}'
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Items">
                            <field name="item_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="portal_home_section_action" model="ir.actions.act_window">
        <field name="name">Home Section</field>
        <field name="res_model">portal.home.section</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem
        id="portal_home_section_menu"
        parent="portal_content_menu_root"
        action="portal_home_section_action"
        sequence="2"
    />

</odoo>
