<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="portal_theme_view_search" model="ir.ui.view">
        <field name="name">portal.theme.search</field>
        <field name="model">portal.theme</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <filter string="Current" name="is_current" domain="[('is_current', '=', True)]" />
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <record id="portal_theme_view_tree" model="ir.ui.view">
        <field name="name">portal.theme.tree</field>
        <field name="model">portal.theme</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="color" widget="color" />
                <field name="date_start" />
                <field name="date_end" />
                <field name="is_current" />
            </tree>
        </field>
    </record>

    <record id="portal_theme_view_form" model="ir.ui.view">
        <field name="name">portal.theme.form</field>
        <field name="model">portal.theme</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="color" widget="color" />
                            <field name="is_current" />

                        </group>
                        <group>
                            <field name="date_start" />
                            <field name="date_end" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="portal_theme_action" model="ir.actions.act_window">
        <field name="name">Themes</field>
        <field name="res_model">portal.theme</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="portal_theme_menu" parent="portal_content_menu_root" action="portal_theme_action" sequence="14" />
</odoo>
