<odoo>
    <record id="product_category_website_image_form" model="ir.ui.view">
        <field name="name">product.category.website.image</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Website"><field name="portal_image" widget="image"/></group>
            </xpath>
        </field>
    </record>
</odoo>
