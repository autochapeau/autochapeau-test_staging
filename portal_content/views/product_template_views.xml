<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_website_card" model="ir.ui.view">
        <field name="name">product.template.form.website.card</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="inside">
                <group string="Website Service Card" invisible="detailed_type != 'service'">
                    <field name="website_card_price_label" placeholder="Starts from / يبدأ من"/>
                    <field name="website_card_price_enabled"/>
                    <field name="website_card_price" invisible="not website_card_price_enabled"/>
                    <div class="text-muted" colspan="2">
                        Display price only. Checkout uses the selected variant's selling price.
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
