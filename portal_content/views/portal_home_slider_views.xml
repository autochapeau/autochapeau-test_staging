<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="portal_home_slider_view_tree" model="ir.ui.view">
        <field name="name">portal.home.slider.tree</field>
        <field name="model">portal.home.slider</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="image_1920" widget="image" options="{'size': [90, 90]}" />
            </tree>
        </field>
    </record>

    <record id="portal_home_slider_view_form" model="ir.ui.view">
        <field name="name">portal.home.slider.form</field>
        <field name="model">portal.home.slider</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field
                            name="image_1920"
                            string="Image"
                            widget="image"
                            options='{"zoom": true, "preview_image": "image_128"}'
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="portal_home_slider_action" model="ir.actions.act_window">
        <field name="name">Home Slider</field>
        <field name="res_model">portal.home.slider</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem
        id="portal_home_slider_menu"
        name="Home Slider"
        parent="portal_home_menu_root"
        action="portal_home_slider_action"
        sequence="4"
    />

</odoo>
