<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_form_service_tag" model="ir.ui.view">
        <field name="name">product.product.form.service.tag</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <field name="detailed_type" position="after">
                <field name="service_tag_id" readonly="1" invisible="detailed_type != 'service'"/>
            </field>
        </field>
    </record>
    <record id="product_form_service_components" model="ir.ui.view">
        <field name="name">product.product.form.service.components</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="work_orders.product_normal_form_view_inherit_car"/>
        <field name="arch" type="xml">
            <xpath expr="//page[field[@name='bom_ids']]" position="replace">
                <page name="service_components" string="Service Components" invisible="detailed_type != 'service'">
                    <p class="text-muted">Select a vehicle part, then open it to configure its materials and quantities.</p>
                    <field name="service_part_ids" context="{'default_service_id': id, 'form_view_ref': 'workorder_service_components.service_part_form'}">
                        <tree>
                            <field name="sequence" widget="handle"/>
                            <field name="part_id"/>
                            <field name="component_count" string="Materials"/>
                        </tree>
                    </field>
                    <group string="Existing Ungrouped Materials">
                        <p class="text-muted">To reuse an existing material, assign it to a configured service part instead of adding it again.</p>
                        <field name="ungrouped_component_ids" nolabel="1">
                            <tree editable="bottom" create="0" delete="0">
                                <field name="service_id" column_invisible="1"/>
                                <field name="service_part_id" domain="[('service_id', '=', service_id)]" options="{'no_create': True}"/>
                                <field name="material_category_id" options="{'no_create': True}"/>
                                <field name="product_id" domain="[('detailed_type', '=', 'product')] + ([('categ_id', 'child_of', material_category_id)] if material_category_id else [])"/>
                                <field name="quantity" string="Default Quantity"/>
                                <field name="product_uom_category_id" column_invisible="1"/>
                                <field name="product_uom_id"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="product_template_form_service_components" model="ir.ui.view">
        <field name="name">product.template.form.service.components</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <page name="general_information" position="after">
                <page name="service_components" string="Service Components" invisible="detailed_type != 'service'">
                    <field name="product_variant_count" invisible="1"/>
                    <button name="%(service_component_batch_action)d" type="action" string="Configure Multiple Variants" class="btn-primary mb-3" context="{'default_product_tmpl_id': id}" invisible="not id" groups="work_orders.group_workshop_manager"/>
                    <p class="text-muted">Save the service first. Use Configure Multiple Variants to apply the same materials to several variants, or open an individual vehicle part to edit its materials.</p>
                    <field name="service_part_ids" invisible="not id" context="{'default_product_tmpl_id': id, 'form_view_ref': 'workorder_service_components.service_part_form'}">
                        <tree>
                            <field name="sequence" widget="handle"/>
                            <field name="part_id"/>
                            <field name="service_id" column_invisible="parent.product_variant_count &lt;= 1"/>
                            <field name="component_count" string="Materials"/>
                        </tree>
                    </field>
                    <group string="Existing Ungrouped Materials">
                        <p class="text-muted">To reuse an existing material, assign it to a configured service part instead of adding it again.</p>
                        <field name="ungrouped_component_ids" nolabel="1">
                            <tree editable="bottom" create="0" delete="0">
                                <field name="service_id"/>
                                <field name="service_part_id" domain="[('service_id', '=', service_id)]" options="{'no_create': True}"/>
                                <field name="material_category_id" options="{'no_create': True}"/>
                                <field name="product_id" domain="[('detailed_type', '=', 'product')] + ([('categ_id', 'child_of', material_category_id)] if material_category_id else [])"/>
                                <field name="quantity" string="Default Quantity"/>
                                <field name="product_uom_category_id" column_invisible="1"/>
                                <field name="product_uom_id"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
