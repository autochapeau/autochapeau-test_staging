<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_category_form_material" model="ir.ui.view">
        <field name="name">product.category.form.main.material</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <field name="is_main_material_category"/>
            </field>
        </field>
    </record>
    <record id="service_component_batch_form" model="ir.ui.view">
        <field name="name">car.service.component.batch.form</field>
        <field name="model">car.service.component.batch</field>
        <field name="arch" type="xml">
            <form string="Configure Variant Materials">
                <group>
                    <field name="product_tmpl_id" readonly="1"/>
                    <field name="part_id"/>
                    <field name="service_ids" widget="many2many_tags" domain="[('product_tmpl_id', '=', product_tmpl_id), ('detailed_type', '=', 'service')]" options="{'no_create': True}"/>
                </group>
                <p class="text-muted">Apply these materials to every selected variant. Existing materials on the same vehicle part are updated by product; other materials are kept. Existing work orders keep their saved materials.</p>
                <field name="line_ids">
                    <tree editable="bottom">
                        <field name="material_category_id" options="{'no_create': True}"/>
                        <field name="product_id" domain="[('detailed_type', '=', 'product'), ('categ_id', 'child_of', material_category_id)]" options="{'no_create': True}"/>
                        <field name="quantity"/>
                        <field name="product_uom_category_id" column_invisible="1"/>
                        <field name="product_uom_id" domain="[('category_id', '=', product_uom_category_id)]" options="{'no_create': True}"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="Apply to Variants" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="service_component_batch_action" model="ir.actions.act_window">
        <field name="name">Configure Variant Materials</field>
        <field name="res_model">car.service.component.batch</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
