<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_category_form_material" model="ir.ui.view">
        <field name="name">product.category.form.main.material</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <field name="is_main_material_category"/>
            </field>
        </field>
    </record>
    <record id="service_component_batch_form" model="ir.ui.view">
        <field name="name">car.service.component.batch.form</field>
        <field name="model">car.service.component.batch</field>
        <field name="arch" type="xml">
            <form string="Configure Variant Materials">
                <group>
                    <field name="product_tmpl_id" readonly="1"/>
                    <field name="part_id" invisible="1"/>
                    <field name="part_ids" widget="many2many_tags"/>
                    <field name="service_ids" widget="many2many_tags" domain="[('product_tmpl_id', '=', product_tmpl_id), ('detailed_type', '=', 'service')]" options="{'no_create': True}"/>
                </group>
                <p class="text-muted">Leave vehicle parts empty for materials used by the whole service.</p>
                <p class="text-muted">Apply to the selected parts and variants. Size overrides below apply to all materials for that variant. For different materials or measurements per part, open the saved part configuration. Existing orders retain their saved configuration.</p>
                <field name="line_ids">
                    <tree editable="bottom">
                        <field name="material_category_id" options="{'no_create': True}"/>
                        <field name="product_id" domain="[('detailed_type', '=', 'product'), ('categ_id', 'child_of', material_category_id)]" options="{'no_create': True}"/>
                        <field name="allowed_brand_ids" widget="many2many_tags" optional="show"/>
                        <field name="usage_mode"/>
                        <field name="standard_length_in" readonly="usage_mode != 'roll'"/>
                        <field name="standard_width_in" readonly="usage_mode != 'roll'"/>
                        <field name="quantity" readonly="usage_mode == 'roll'"/>
                        <field name="product_uom_category_id" column_invisible="1"/>
                        <field name="product_uom_id" domain="[('category_id', '=', product_uom_category_id)] if product_uom_category_id else []" options="{'no_create': True}"/>
                    </tree>
                </field>
                <separator string="Optional Size Overrides"/>
                <field name="variant_line_ids">
                    <tree editable="bottom">
                        <field name="service_id" domain="[('id', 'in', parent.service_ids)]" options="{'no_create': True}"/>
                        <field name="quantity"/>
                        <field name="product_uom_id"/>
                        <field name="standard_length_in"/>
                        <field name="standard_width_in"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="Apply to Variants" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="service_component_batch_action" model="ir.actions.act_window">
        <field name="name">Configure Variant Materials</field>
        <field name="res_model">car.service.component.batch</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'extra-large'}</field>
    </record>
</odoo>
