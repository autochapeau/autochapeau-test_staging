<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="car_work_order_form_service_components" model="ir.ui.view">
    <field name="name">car.work.order.form.service.components</field>
    <field name="model">car.work.order</field>
    <field name="inherit_id" ref="work_orders.car_work_order_view_form"/>
    <field name="priority">99</field>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='products']//field[@name='product_ids']" position="replace">
        <field name="product_ids" colspan="2" nolabel="1" invisible="state != 'new'">
          <tree editable="bottom">
            <field name="source_task_id" column_invisible="1"/>
            <field name="materials_issued" column_invisible="1"/>
            <field name="service_id" readonly="parent.state != 'new'" options="{'no_create': True}"/>
            <field name="part_id" readonly="parent.state != 'new'" options="{'no_create': True}"/>
            <field name="tag_id" readonly="parent.state != 'new'" options="{'no_create': True}"/>
            <field name="product_id" readonly="parent.state != 'new'" options="{'no_create': True}"/>
            <field name="suggested_qty" readonly="1" force_save="1"/>
            <field name="quantity" string="Used Quantity" readonly="materials_issued or (parent.state != 'new' and (not source_task_id or parent.state != 'progress'))"/>
            <field name="company_id" column_invisible="1"/>
            <field name="lot_id" optional="hide" readonly="materials_issued" options="{'no_create': True}"/>
            <field name="product_uom_category_id" column_invisible="1"/>
            <field name="used_uom_id" readonly="parent.state != 'new'" options="{'no_create': True}"/>
          </tree>
        </field>
        <field name="product_ids" colspan="2" nolabel="1" invisible="state == 'new'" readonly="state not in ('confirmed', 'progress')">
          <tree editable="bottom" create="0" delete="0">
            <field name="source_task_id" column_invisible="1"/>
            <field name="materials_issued" column_invisible="1"/>
            <field name="service_id" readonly="parent.state != 'new'" options="{'no_create': True}"/>
            <field name="part_id" readonly="parent.state != 'new'" options="{'no_create': True}"/>
            <field name="tag_id" readonly="parent.state != 'new'" options="{'no_create': True}"/>
            <field name="product_id" readonly="parent.state != 'new'" options="{'no_create': True}"/>
            <field name="suggested_qty" readonly="1" force_save="1"/>
            <field name="quantity" string="Used Quantity" readonly="materials_issued or (parent.state != 'new' and (not source_task_id or parent.state != 'progress'))"/>
            <field name="company_id" column_invisible="1"/>
            <field name="lot_id" optional="hide" readonly="materials_issued" options="{'no_create': True}"/>
            <field name="product_uom_category_id" column_invisible="1"/>
            <field name="used_uom_id" readonly="parent.state != 'new'" options="{'no_create': True}"/>
          </tree>
        </field>
      </xpath>
      <xpath expr="//div[@name='button_box']" position="inside">
        <field name="materials_finished" invisible="1"/>
        <button name="action_start_materials" type="object" class="oe_stat_button" icon="fa-play" string="Start Services" invisible="state not in ('confirmed', 'progress') or materials_finished" groups="work_orders.group_workshop_manager"/>
        <button name="action_finish_materials" type="object" class="oe_stat_button" icon="fa-check" string="Finish Services" invisible="state != 'progress' or materials_finished" confirm="Finish all running services and issue their actual material quantities from stock?" groups="work_orders.group_workshop_manager"/>
        <button name="action_view_material_pickings" type="object" class="oe_stat_button" icon="fa-cubes" invisible="material_picking_count == 0" groups="stock.group_stock_user">
          <field name="material_picking_count" widget="statinfo" string="Material Deliveries"/>
        </button>
      </xpath>
    </field>
  </record>
</odoo>
