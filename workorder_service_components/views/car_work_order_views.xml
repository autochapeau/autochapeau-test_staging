<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="car_work_order_form_service_components" model="ir.ui.view">
    <field name="name">car.work.order.form.service.components</field>
    <field name="model">car.work.order</field>
    <field name="inherit_id" ref="work_orders.car_work_order_view_form"/>
    <field name="priority">99</field>
    <field name="arch" type="xml">
      <xpath expr="//form/header" position="before">
        <field name="material_preparation_enabled" invisible="1"/>
      </xpath>
      <xpath expr="//page[@name='products']//field[@name='product_ids']" position="replace">
        <field name="product_ids" colspan="2" nolabel="1" invisible="state != 'new'">
          <tree editable="bottom" decoration-warning="material_stock_shortage">
            <field name="material_stock_shortage" column_invisible="1"/>
            <field name="source_task_id" column_invisible="1"/>
            <field name="materials_issued" column_invisible="1"/>
            <field name="service_id" readonly="parent.state != 'new'" options="{'no_create': True}"/>
            <field name="part_id" readonly="parent.state != 'new'" options="{'no_create': True}"/>
            <field name="material_category_id" readonly="1"/>
            <field name="tag_id" readonly="parent.state != 'new' or material_category_id" optional="hide" options="{'no_create': True}"/>
            <field name="material_brand_id" domain="[('id', 'in', allowed_brand_ids)] if allowed_brand_ids else []" readonly="materials_issued" options="{'no_create': True}"/>
            <field name="product_id" domain="[('detailed_type', '!=', 'service')] + ([('categ_id', 'child_of', material_category_id)] if material_category_id else ([('product_tag_ids', 'in', [tag_id])] if tag_id else [])) + ([('material_brand_id', 'in', allowed_brand_ids)] if allowed_brand_ids else []) + ([('material_brand_id', '=', material_brand_id)] if material_brand_id else [])" readonly="((material_category_id or source_task_id) and not material_brand_id) or materials_issued or (parent.state != 'new' and (not material_category_id or parent.state not in ('confirmed', 'progress')))" options="{'no_create': True}"/>
            <field name="usage_mode" readonly="1" optional="show"/>
            <field name="allowed_brand_ids" widget="many2many_tags" readonly="1" optional="hide"/>
            <field name="standard_length_in" readonly="1" optional="show" invisible="parent.material_preparation_enabled and not product_id"/>
            <field name="standard_width_in" readonly="1" optional="show" invisible="parent.material_preparation_enabled and not product_id"/>
            <field name="actual_length_in" readonly="materials_issued or usage_mode != 'roll'" optional="show" invisible="parent.material_preparation_enabled and not product_id"/>
            <field name="actual_width_in" readonly="materials_issued or usage_mode != 'roll'" optional="show" invisible="parent.material_preparation_enabled and not product_id"/>
            <field name="film_width_in" readonly="1" optional="show"/>
            <field name="roll_length_m" readonly="1" optional="hide"/>
            <field name="dimension_warning" readonly="1" optional="show"/>
            <field name="suggested_qty" readonly="1"/>
            <field name="quantity" string="Used Quantity" readonly="usage_mode == 'roll' or materials_issued or (parent.state != 'new' and (not source_task_id or parent.state != 'progress'))"/>
            <field name="branch_available_qty" readonly="1"/>
            <field name="availability_warehouse_id" readonly="1" optional="hide" options="{'no_open': True}"/>
            <field name="material_stock_warning" readonly="1" optional="show"/>
            <field name="company_id" column_invisible="1"/>
            <field name="lot_id" optional="hide" readonly="materials_issued" options="{'no_create': True}"/>
            <field name="product_uom_category_id" column_invisible="1"/>
            <field name="used_uom_id" readonly="parent.state != 'new'" options="{'no_create': True}"/>
          </tree>
        </field>
        <field name="product_ids" colspan="2" nolabel="1" invisible="state == 'new'" readonly="state not in ('confirmed', 'progress')">
          <tree editable="bottom" create="0" delete="0" decoration-warning="material_stock_shortage">
            <field name="material_stock_shortage" column_invisible="1"/>
            <field name="source_task_id" column_invisible="1"/>
            <field name="materials_issued" column_invisible="1"/>
            <field name="service_id" readonly="parent.state != 'new'" options="{'no_create': True}"/>
            <field name="part_id" readonly="parent.state != 'new'" options="{'no_create': True}"/>
            <field name="material_category_id" readonly="1"/>
            <field name="tag_id" readonly="parent.state != 'new' or material_category_id" optional="hide" options="{'no_create': True}"/>
            <field name="material_brand_id" domain="[('id', 'in', allowed_brand_ids)] if allowed_brand_ids else []" readonly="materials_issued" options="{'no_create': True}"/>
            <field name="product_id" domain="[('detailed_type', '!=', 'service')] + ([('categ_id', 'child_of', material_category_id)] if material_category_id else ([('product_tag_ids', 'in', [tag_id])] if tag_id else [])) + ([('material_brand_id', 'in', allowed_brand_ids)] if allowed_brand_ids else []) + ([('material_brand_id', '=', material_brand_id)] if material_brand_id else [])" readonly="not material_brand_id or materials_issued or not material_category_id or parent.state not in ('confirmed', 'progress')" options="{'no_create': True}"/>
            <field name="usage_mode" readonly="1" optional="show"/>
            <field name="allowed_brand_ids" widget="many2many_tags" readonly="1" optional="hide"/>
            <field name="standard_length_in" readonly="1" optional="show" invisible="parent.material_preparation_enabled and not product_id"/>
            <field name="standard_width_in" readonly="1" optional="show" invisible="parent.material_preparation_enabled and not product_id"/>
            <field name="actual_length_in" readonly="materials_issued or usage_mode != 'roll'" optional="show" invisible="parent.material_preparation_enabled and not product_id"/>
            <field name="actual_width_in" readonly="materials_issued or usage_mode != 'roll'" optional="show" invisible="parent.material_preparation_enabled and not product_id"/>
            <field name="film_width_in" readonly="1" optional="show"/>
            <field name="roll_length_m" readonly="1" optional="hide"/>
            <field name="dimension_warning" readonly="1" optional="show"/>
            <field name="suggested_qty" readonly="1"/>
            <field name="quantity" string="Used Quantity" readonly="usage_mode == 'roll' or materials_issued or (parent.state != 'new' and (not source_task_id or parent.state != 'progress'))"/>
            <field name="branch_available_qty" readonly="1"/>
            <field name="availability_warehouse_id" readonly="1" optional="hide" options="{'no_open': True}"/>
            <field name="material_stock_warning" readonly="1" optional="show"/>
            <field name="company_id" column_invisible="1"/>
            <field name="lot_id" optional="hide" readonly="materials_issued" options="{'no_create': True}"/>
            <field name="product_uom_category_id" column_invisible="1"/>
            <field name="used_uom_id" readonly="parent.state != 'new'" options="{'no_create': True}"/>
          </tree>
        </field>
      </xpath>
      <xpath expr="//page[@name='products']" position="inside">
        <group string="Car Film Totals"><field name="material_used_length_m"/><field name="material_used_width_m"/><field name="material_used_area_m2"/></group>
        <p class="text-muted">Film dimensions are in inches. Total lengths and widths are sums of all cuts. Film stock quantity uses cut area divided by the area represented by one raw-material stock unit. Exceeding the standard plus part tolerance is blocked. Total car budget warnings are advisory.</p>
      </xpath>
      <xpath expr="//field[@name='service_ids']/tree" position="inside">
        <field name="material_total_length_in" optional="show" column_invisible="parent.state == 'new' or parent.material_preparation_enabled"/>
        <field name="material_total_width_in" optional="show" column_invisible="parent.state == 'new' or parent.material_preparation_enabled"/>
        <field name="material_tolerance_in" optional="hide" column_invisible="parent.state == 'new' or parent.material_preparation_enabled"/>
        <field name="material_used_length_in" optional="show" column_invisible="parent.state == 'new' or parent.material_preparation_enabled"/>
        <field name="material_used_width_in" optional="show" column_invisible="parent.state == 'new' or parent.material_preparation_enabled"/>
        <field name="material_used_area_m2" optional="hide" column_invisible="parent.state == 'new' or parent.material_preparation_enabled"/>
        <field name="material_budget_warning" optional="show" column_invisible="parent.state == 'new' or parent.material_preparation_enabled"/>
      </xpath>
      <xpath expr="//div[@name='button_box']" position="inside">
        <field name="materials_finished" invisible="1"/>
        <button name="action_start_materials" type="object" class="oe_stat_button" icon="fa-play" string="Start Services" invisible="state not in ('confirmed', 'progress') or materials_finished" groups="work_orders.group_workshop_manager"/>
        <button name="action_finish_materials" type="object" class="oe_stat_button" icon="fa-check" string="Finish Services" invisible="state != 'progress' or materials_finished" confirm="Finish all running services and issue their actual material quantities from stock?" groups="work_orders.group_workshop_manager"/>
        <button name="action_view_material_pickings" type="object" class="oe_stat_button" icon="fa-cubes" invisible="material_picking_count == 0" groups="stock.group_stock_user">
          <field name="material_picking_count" widget="statinfo" string="Material Deliveries"/>
        </button>
      </xpath>
    </field>
  </record>
</odoo>
