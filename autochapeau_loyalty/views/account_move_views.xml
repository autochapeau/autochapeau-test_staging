<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_form_autochapeau_loyalty" model="ir.ui.view">
        <field name="name">account.move.form.autochapeau.loyalty</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_grant_autochapeau_loyalty_points"
                        type="object"
                        string="Grant Loyalty Points"
                        class="btn-secondary"
                        invisible="move_type != 'out_invoice' or state != 'posted' or payment_state not in ('paid', 'in_payment') or loyalty_points_granted"/>
            </xpath>
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="loyalty_points_granted"
                       invisible="move_type != 'out_invoice'"/>
            </xpath>
        </field>
    </record>
</odoo>
