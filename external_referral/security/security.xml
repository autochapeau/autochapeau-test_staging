<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="external_referral_company_rule" model="ir.rule">
        <field name="name">External Referral: allowed companies</field>
        <field name="model_id" ref="model_external_referral"/>
        <field name="domain_force">[
            ('company_id', 'in', company_ids)
        ]</field>
        <field name="groups" eval="[
            (4, ref('sales_team.group_sale_salesman'))
        ]"/>
    </record>
</odoo>
