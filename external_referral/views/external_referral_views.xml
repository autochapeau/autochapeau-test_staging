<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_external_referral_search" model="ir.ui.view">
        <field name="name">external.referral.search</field>
        <field name="model">external.referral</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="agency_id"/>
                <field name="agency_salesperson_id"/>
                <field name="sale_order_id"/>
                <field name="invoice_id"/>
                <filter name="due" string="Due"
                        domain="[('state', '=', 'due')]"/>
                <filter name="paid" string="Paid"
                        domain="[('state', '=', 'paid')]"/>
                <filter name="cancelled" string="Cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_salesperson"
                            string="Agency Salesperson"
                            context="{'group_by': 'agency_salesperson_id'}"/>
                    <filter name="group_agency"
                            string="Agency"
                            context="{'group_by': 'agency_id'}"/>
                    <filter name="group_state"
                            string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_invoice_date"
                            string="Invoice Date"
                            context="{'group_by': 'invoice_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_external_referral_tree" model="ir.ui.view">
        <field name="name">external.referral.tree</field>
        <field name="model">external.referral</field>
        <field name="arch" type="xml">
            <tree create="0" delete="0">
                <header>
                    <button name="action_generate_referrals"
                            type="object"
                            string="Generate Referrals"
                            class="btn-primary"
                            display="always"
                            groups="sales_team.group_sale_manager"/>
                </header>
                <field name="name"/>
                <field name="invoice_date"/>
                <field name="agency_id"/>
                <field name="agency_salesperson_id"/>
                <field name="sale_order_id"/>
                <field name="invoice_id"/>
                <field name="base_amount" sum="Total Untaxed Base"/>
                <field name="referral_percent"/>
                <field name="amount" sum="Total Amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state"
                       widget="badge"
                       decoration-warning="state == 'due'"
                       decoration-success="state == 'paid'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="paid_date" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_external_referral_form" model="ir.ui.view">
        <field name="name">external.referral.form</field>
        <field name="model">external.referral</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_mark_paid"
                            type="object"
                            string="Mark Paid"
                            class="oe_highlight"
                            groups="sales_team.group_sale_manager"
                            invisible="state != 'due'"/>
                    <button name="action_reset_to_due"
                            type="object"
                            string="Reset to Due"
                            groups="sales_team.group_sale_manager"
                            invisible="state != 'paid'"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="due,paid,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Referral">
                            <field name="agency_id"/>
                            <field name="agency_salesperson_id"/>
                            <field name="sale_order_id"/>
                            <field name="invoice_id"/>
                            <field name="invoice_date"/>
                        </group>
                        <group string="Amount">
                            <field name="base_amount"/>
                            <field name="referral_percent"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id"/>
                            <field name="paid_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="payment_reference"
                               readonly="state != 'due'"/>
                        <field name="note" readonly="state == 'cancelled'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_external_referral" model="ir.actions.act_window">
        <field name="name">External Referrals</field>
        <field name="res_model">external.referral</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_external_referral_search"/>
        <field name="context">{'search_default_due': 1}</field>
    </record>

    <menuitem id="menu_external_referral"
              name="External Referrals"
              parent="sale.sale_order_menu"
              action="action_external_referral"
              groups="sales_team.group_sale_salesman"
              sequence="50"/>
</odoo>
