<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form_external_referral" model="ir.ui.view">
        <field name="name">sale.order.form.external.referral</field>
        <field name="model">sale.order</field>
        <field name="inherit_id"
               ref="cars_management.view_order_form_inherit_cars_management"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='commission_amount']"
                   position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='commission_amount']" position="after">
                <field name="external_referral_percent"
                       readonly="1"
                       invisible="order_type != 'extern'"/>
                <field name="external_referral_expected_amount"
                       readonly="1"
                       invisible="order_type != 'extern'"/>
                <field name="external_referral_total"
                       readonly="1"
                       invisible="order_type != 'extern' or external_referral_count == 0"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_external_referrals"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-handshake-o"
                        invisible="external_referral_count == 0">
                    <field name="external_referral_count"
                           widget="statinfo"
                           string="Referrals"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
