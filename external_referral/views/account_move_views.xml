<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_form_external_referral" model="ir.ui.view">
        <field name="name">account.move.form.external.referral</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_external_referrals"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-handshake-o"
                        invisible="move_type != 'out_invoice' or external_referral_count == 0">
                    <field name="external_referral_count"
                           widget="statinfo"
                           string="Referrals"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='invoice_payment_term_id']"
                   position="after">
                <field name="external_referral_total"
                       readonly="1"
                       invisible="move_type != 'out_invoice' or external_referral_count == 0"/>
            </xpath>
        </field>
    </record>
</odoo>
