<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_deferred_revenue" model="ir.ui.view">
        <field name="name">account.move.form.deferred.revenue</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_deferred_entries"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar"
                        invisible="deferred_entry_count == 0">
                    <field name="deferred_entry_count" widget="statinfo" string="Deferred Entries"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_subtotal']" position="after">
                <field name="deferred_start_date" optional="show"/>
                <field name="deferred_end_date" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
