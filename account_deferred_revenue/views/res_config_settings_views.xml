<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_deferred_revenue" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.deferred.revenue</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='default_accounts']" position="after">
                <block title="Deferred Revenue" id="deferred_revenue_settings">
                    <setting string="Deferred Revenue Journal"
                             help="Miscellaneous journal used for deferral and recognition entries.">
                        <field name="deferred_revenue_journal_id"/>
                    </setting>
                    <setting string="Deferred Revenue Account"
                             help="Liability account that holds unearned revenue until it is recognized.">
                        <field name="deferred_revenue_account_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
