<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_sale_split_payment">
        <field name="name">Sale Collection Payments</field>
        <field name="sequence">48</field>
    </record>

    <record id="group_split_payment_cashier" model="res.groups">
        <field name="name">Sale Payment Cashier</field>
        <field name="category_id" ref="module_category_sale_split_payment"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Can collect and process advance payments from sale orders.</field>
    </record>

    <record id="sale_order_payment_company_rule" model="ir.rule">
        <field name="name">Sale collection payments by company</field>
        <field name="model_id" ref="model_sale_order_payment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="sale_collection_method_company_rule" model="ir.rule">
        <field name="name">Sale collection methods by company</field>
        <field name="model_id" ref="model_sale_collection_method"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
