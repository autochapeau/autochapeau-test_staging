<odoo>
    <record id="view_journal_collection_fees" model="ir.ui.view">
        <field name="name">account.journal.collection.fees</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="collection_fees" string="Collection Fees" invisible="type not in ('bank', 'cash')">
                    <field name="company_id" invisible="1"/>
                    <group>
                        <field name="collection_fee_enabled"/>
                        <field name="collection_fee_percent" required="collection_fee_enabled"/>
                        <field name="collection_fee_tax_percent"/>
                        <field name="collection_fee_account_id" required="collection_fee_enabled"
                               options="{'no_create': True}"/>
                        <field name="collection_fee_tax_account_id" required="collection_fee_enabled and collection_fee_tax_percent != 0"
                               options="{'no_create': True}"/>
                    </group>
                    <p>Customer receipts keep their full amount on the customer account. Fees and tax on fees are deducted from the amount received by the bank or cash account.</p>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_payment_collection_fees" model="ir.ui.view">
        <field name="name">account.payment.collection.fees</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="transfer_proof_required" invisible="1"/>
                <field name="collection_fee_account_id" invisible="1"/>
                <group string="Transfer Proof" invisible="not transfer_proof_required">
                    <field name="transfer_proof_ids" widget="many2many_binary" readonly="state != 'draft'"/>
                </group>
                <group string="Collection Breakdown" invisible="not collection_fee_account_id">
                    <field name="collection_fee_percent" string="Fee %"/>
                    <field name="collection_fee_tax_percent" string="Tax on Fee %"/>
                    <field name="collection_fee_amount" string="Fee"/>
                    <field name="collection_fee_tax_amount" string="Tax on Fee"/>
                    <field name="collection_net_amount"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_register_transfer_proof" model="ir.ui.view">
        <field name="name">account.payment.register.transfer.proof</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/group" position="after">
                <field name="journal_type" invisible="1"/>
                <field name="transfer_proof_ids" widget="many2many_binary" invisible="journal_type != 'bank'"
                       required="journal_type == 'bank'"/>
            </xpath>
        </field>
    </record>
    <record id="view_collect_single_transfer_proof" model="ir.ui.view">
        <field name="name">sale.split.payment.wizard.transfer.proof</field>
        <field name="model">sale.split.payment.wizard</field>
        <field name="inherit_id" ref="sale_split_payment.view_sale_split_payment_wizard_form"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="journal_type" invisible="1"/>
                <field name="transfer_proof_ids" widget="many2many_binary" invisible="journal_type != 'bank'"
                       required="journal_type == 'bank' and processing_type == 'manual'"/>
            </field>
        </field>
    </record>
    <record id="view_collect_multiple_transfer_proof" model="ir.ui.view">
        <field name="name">sale.multi.split.payment.wizard.transfer.proof</field>
        <field name="model">sale.multi.split.payment.wizard</field>
        <field name="inherit_id" ref="sale_split_payment.view_sale_multi_split_payment_wizard_form"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="journal_type" invisible="1"/>
                <field name="transfer_proof_ids" widget="many2many_binary" invisible="journal_type != 'bank'"
                       required="journal_type == 'bank'"/>
            </field>
        </field>
    </record>
</odoo>
