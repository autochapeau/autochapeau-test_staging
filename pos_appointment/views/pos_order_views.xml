<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form_appointment" model="ir.ui.view">
        <field name="name">pos.order.form.appointment</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_appointment"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-calendar"
                    invisible="not appointment_id"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Appointment</span>
                    </div>
                </button>
                <button
                    name="action_book_appointment"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-calendar-plus-o"
                    invisible="appointment_id or not partner_id"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Book Appointment</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="appointment_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_tree_appointment" model="ir.ui.view">
        <field name="name">pos.order.tree.appointment</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="appointment_id" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
