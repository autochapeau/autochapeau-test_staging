<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_department_form_show_on_website" model="ir.ui.view">
        <field name="name">hr.department.form.show.on.website</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr_branch_department.view_hr_department_form_inherit_branch"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='department_type']" position="after">
                <field name="show_on_website" invisible="department_type != 'branche'"/>
            </xpath>
        </field>
    </record>
</odoo>
