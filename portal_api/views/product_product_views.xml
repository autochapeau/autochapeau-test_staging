<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="product_normal_form_view_web_note" model="ir.ui.view">
        <field name="name">product.product.form.web.note</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <field name="detailed_type" position="after">
                <field name="web_note" />
            </field>
        </field>
    </record>

    <record id="product_variant_easy_edit_web_note" model="ir.ui.view">
        <field name="name">product.product.view.form.easy.web.note</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view" />
        <field name="arch" type="xml">
            <field name="lst_price" position="after">
                <field name="web_note" />
            </field>
        </field>
    </record>

</odoo>
