<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="point_of_sale.ActionpadWidget" t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('text-truncate')]" position="inside">
            <div t-if="selectedVehicleName" class="text-muted small text-truncate">
                <i class="fa fa-car me-1"/>
                <t t-esc="selectedVehicleName"/>
            </div>
        </xpath>
    </t>
</templates>
